                    start=0)) annotation (Placement(visible=true, transformation(
                    origin={30,0},
                    extent={{10,-10},{-10,10}},
                    rotation=90)));
              Modelica.Electrical.Analog.Sources.ConstantVoltage constantVoltage(V=
                    VDC) annotation (Placement(transformation(
