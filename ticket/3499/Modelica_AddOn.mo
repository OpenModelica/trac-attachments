                        points={{-100,100},{-100,40},{100,-40},{100,-100}},
                        color={255,170,85},
                        smooth=Smooth.None),Line(
                        points={{100,100},{100,40},{-100,-40},{-100,-100}},
                        color={255,170,85},
                        smooth=Smooth.None)}),
