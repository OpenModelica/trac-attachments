                      extent={{0,-50},{100,-70}},
                      lineColor={0,0,127},
                      fillColor={255,255,255},
                      fillPattern=FillPattern.Solid,
                      textString="DC"),Rectangle(
                      extent={{-40,24},{40,-24}},
                      lineColor={255,255,255},
                      fillColor={255,255,255},
                      fillPattern=FillPattern.Solid),Line(
                      points={{-40,0},{40,0}},
                      color={0,0,255},
                      smooth=Smooth.None),Line(
                      points={{20,24},{20,-24}},
                      color={0,0,255},
