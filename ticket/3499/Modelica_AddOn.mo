              color={0,0,255},
              smooth=Smooth.None));
          connect(thyristor_p1.n, dc_p) annotation (Line(
              points={{-20,60},{100,60}},
              color={0,0,255},
              smooth=Smooth.None));
          connect(thyristor_n1.p, dc_n) annotation (Line(
