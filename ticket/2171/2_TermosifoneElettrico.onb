p, li { white-space: pre-wrap; }
&lt;/style>&lt;/head>&lt;body style=" font-family:'MS Shell Dlg 2'; font-size:8.25pt; font-weight:400; font-style:normal;">
&lt;table border="0" style="-qt-table-type: root; margin-top:10px; margin-bottom:10px; margin-left:10px; margin-right:10px;">
&lt;tr>
&lt;td style="border: none;">
&lt;p style=" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;">&lt;span style=" font-family:'Arial'; font-size:38pt; font-weight:600; color:#000000;">Controlli Automatici (per Energetici)&lt;/span>&lt;/p>&lt;/td>&lt;/tr>&lt;/table>&lt;/body>&lt;/html></Text>
    </TextCell>
    <TextCell style="Subtitle">
      <Text>&lt;!DOCTYPE HTML PUBLIC "-//W3C//DTD HTML 4.0//EN" "http://www.w3.org/TR/REC-html40/strict.dtd">
&lt;html>&lt;head>&lt;meta name="qrichtext" content="1" />&lt;style type="text/css">
p, li { white-space: pre-wrap; }
&lt;/style>&lt;/head>&lt;body style=" font-family:'MS Shell Dlg 2'; font-size:8.25pt; font-weight:400; font-style:normal;">
&lt;table border="0" style="-qt-table-type: root; margin-top:5px; margin-bottom:5px; margin-left:5px; margin-right:5px;">
&lt;tr>
&lt;td style="border: none;">
&lt;p style=" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;">&lt;span style=" font-family:'Arial'; font-size:24pt; font-style:italic; color:#000000;">Laboratorio - A.A. 2010/2011&lt;/span>&lt;/p>&lt;/td>&lt;/tr>&lt;/table>&lt;/body>&lt;/html></Text>
    </TextCell>
    <TextCell style="Section">
      <Text>&lt;!DOCTYPE HTML PUBLIC "-//W3C//DTD HTML 4.0//EN" "http://www.w3.org/TR/REC-html40/strict.dtd">
&lt;html>&lt;head>&lt;meta name="qrichtext" content="1" />&lt;style type="text/css">
p, li { white-space: pre-wrap; }
&lt;/style>&lt;/head>&lt;body style=" font-family:'MS Shell Dlg 2'; font-size:8.25pt; font-weight:400; font-style:normal;">
&lt;table border="0" style="-qt-table-type: root; margin-top:5px; margin-bottom:5px; margin-left:5px; margin-right:5px;">
&lt;tr>
&lt;td style="border: none;">
&lt;p style=" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;">&lt;span style=" font-family:'Times'; font-size:18pt; font-weight:600; color:#000000;">Termosifone elettrico&lt;/span>&lt;/p>&lt;/td>&lt;/tr>&lt;/table>&lt;/body>&lt;/html></Text>
    </TextCell>
    <TextCell style="Text">
      <Text>&lt;!DOCTYPE HTML PUBLIC "-//W3C//DTD HTML 4.0//EN" "http://www.w3.org/TR/REC-html40/strict.dtd">
&lt;html>&lt;head>&lt;meta name="qrichtext" content="1" />&lt;style type="text/css">
p, li { white-space: pre-wrap; }
&lt;/style>&lt;/head>&lt;body style=" font-family:'MS Shell Dlg 2'; font-size:8.25pt; font-weight:400; font-style:normal;">
&lt;table border="0" style="-qt-table-type: root; margin-top:5px; margin-bottom:5px; margin-left:5px; margin-right:5px;">
&lt;tr>
&lt;td style="border: none;">
&lt;p style=" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;">&lt;span style=" font-family:'Times New Roman'; font-size:12pt; color:#000000;">Andiamo ora a considerare il modello di un termosifone elettrico, come mostrato nella figura seguente&lt;/span>&lt;/p>&lt;/td>&lt;/tr>&lt;/table>&lt;/body>&lt;/html></Text>
    </TextCell>
    <TextCell style="Text">
      <Text>&lt;!DOCTYPE HTML PUBLIC "-//W3C//DTD HTML 4.0//EN" "http://www.w3.org/TR/REC-html40/strict.dtd">
&lt;html>&lt;head>&lt;meta name="qrichtext" content="1" />&lt;style type="text/css">
p, li { white-space: pre-wrap; }
&lt;/style>&lt;/head>&lt;body style=" font-family:'MS Shell Dlg 2'; font-size:8.25pt; font-weight:400; font-style:normal;">
&lt;table border="0" style="-qt-table-type: root; margin-top:5px; margin-bottom:5px; margin-left:5px; margin-right:5px;">
&lt;tr>
&lt;td style="border: none;">
&lt;p style=" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;">&lt;img src="file:///C:/DOCUME~1/casella/IMPOST~1/Temp/OpenModelica/9.png" width="400" height="251" />&lt;/p>
&lt;p style="-qt-paragraph-type:empty; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; font-family:'Times New Roman'; font-size:12pt; color:#000000;">&lt;br />&lt;/p>
&lt;p style="-qt-paragraph-type:empty; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; font-family:'Sans'; font-size:10pt;">&lt;br />&lt;/p>
&lt;p style=" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;">&lt;img src="file:///C:/DOCUME~1/casella/IMPOST~1/Temp/OpenModelica/10.png" width="164" height="58" />&lt;span style=" font-family:'Times New Roman'; font-size:12pt; color:#000000;">conservazione dell'energia&lt;/span>&lt;/p>
&lt;p style="-qt-paragraph-type:empty; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; font-family:'Times New Roman'; font-size:12pt; color:#000000;">&lt;br />&lt;/p>
&lt;p style=" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;">&lt;span style=" font-family:'Times New Roman'; font-size:12pt; color:#000000;"> &lt;/span>&lt;img src="file:///C:/DOCUME~1/casella/IMPOST~1/Temp/OpenModelica/11.png" width="85" height="28" />&lt;span style=" font-family:'Times New Roman'; font-size:12pt; color:#000000;">                   energia della massa metallica&lt;/span>&lt;/p>
&lt;p style="-qt-paragraph-type:empty; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; font-family:'Sans'; font-size:10pt;">&lt;br />&lt;/p>
&lt;p style=" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;">&lt;img src="file:///C:/DOCUME~1/casella/IMPOST~1/Temp/OpenModelica/12.png" width="144" height="31" />&lt;span style=" font-family:'Times New Roman'; font-size:12pt; color:#000000;">     calore disperso verso l'ambiente&lt;/span>&lt;/p>
&lt;p style="-qt-paragraph-type:empty; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; font-family:'Times New Roman'; font-size:12pt; color:#000000;">&lt;br />&lt;/p>
&lt;p style=" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;">&lt;span style=" font-family:'Times New Roman'; font-size:12pt; color:#000000;">Equazione di stato&lt;/span>&lt;/p>
&lt;p style=" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;">&lt;img src="file:///C:/DOCUME~1/casella/IMPOST~1/Temp/OpenModelica/13.png" width="215" height="42" />&lt;/p>
&lt;p style="-qt-paragraph-type:empty; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; font-family:'Sans'; font-size:10pt;">&lt;br />&lt;/p>
&lt;p style=" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;">&lt;span style=" font-family:'Sans'; font-size:10pt; font-weight:600;">Calcolo dell'equilibrio&lt;/span>&lt;/p>
&lt;p style="-qt-paragraph-type:empty; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; font-family:'Sans'; font-size:10pt;">&lt;br />&lt;/p>
&lt;p style=" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;">&lt;span style=" font-family:'Times New Roman'; font-size:12pt; color:#000000;">Per il calcolo dello stato di equilibrio, desideriamo che la potenza erogata dal termosifone sia pari ad un certo valore, data una certa condizione per la temperatura dell'aria circostante. Il sistema, essendo all'equilibrio, non ha variazioni, quindi la derivata dell'energia (e quindi della temperatura) è nulla, pertanto&lt;/span>&lt;/p>
&lt;p style=" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;">&lt;img src="file:///C:/DOCUME~1/casella/IMPOST~1/Temp/OpenModelica/14.png" width="232" height="40" />&lt;/p>
&lt;p style=" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;">&lt;span style=" font-family:'Times New Roman'; font-size:12pt; color:#000000;">si ogiunge quindi alla seguente conclusione: Il termosifone dovra raggiungere una certa temperatura T, mentre la potenza somministrata dovrà essere pari a quella ceduta dal termosifone all'ambiente &lt;/span>&lt;/p>
&lt;p style=" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;">&lt;img src="file:///C:/DOCUME~1/casella/IMPOST~1/Temp/OpenModelica/15.png" width="201" height="84" />&lt;/p>&lt;/td>&lt;/tr>&lt;/table>&lt;/body>&lt;/html></Text>
      <Image name="file:///C:/DOCUME~1/casella/IMPOST~1/Temp/OpenModelica/9.png"></Image>
      <Image name="file:///C:/DOCUME~1/casella/IMPOST~1/Temp/OpenModelica/10.png"></Image>
      <Image name="file:///C:/DOCUME~1/casella/IMPOST~1/Temp/OpenModelica/11.png"></Image>
      <Image name="file:///C:/DOCUME~1/casella/IMPOST~1/Temp/OpenModelica/12.png"></Image>
      <Image name="file:///C:/DOCUME~1/casella/IMPOST~1/Temp/OpenModelica/13.png"></Image>
      <Image name="file:///C:/DOCUME~1/casella/IMPOST~1/Temp/OpenModelica/14.png"></Image>
      <Image name="file:///C:/DOCUME~1/casella/IMPOST~1/Temp/OpenModelica/15.png"></Image>
    </TextCell>
    <GraphCell style="Graph" closed="false">
      <Input>model TermosifoneElettrico
  Real Qin;
  Real Qout;
  Real T (start = Teq) "temperatura del metallo";
  parameter Real Tair = 14 "temperatura dell'aria";
  parameter Real Qo = 1000 "potenza desiderata";
  parameter Real k = 20 "coeff. scambio convettivo";    
  parameter Real C = 500 "capacità termica metallo";
  parameter Real S = 2 "superficie che scambia con l'ambiente";
  parameter Real m = 50 "massa di metallo";
  parameter Real Teq = Tair + Qo/S/k "temperatura del metallo all'equilibrio";
  parameter Real Qeq = Qo "Potenza all'equilibrio";
  parameter Real DeltaQ = 0 "Variazione della potenza d'ingresso";
  parameter Real f  = 0 "frequenza della variazione della tensione d'ingresso";
equation
  // conservazione dell'energia  
  C*m*der(T) = Qin - Qout;
  
  // potenza uscente
  Qout = S*k*(T-Tair);
  
  // potenza entrante
  Qin = if time&lt;0 then Qeq else Qeq+DeltaQ*cos(6.28*f*time);
end TermosifoneElettrico;
</Input>
      <Output>{TermosifoneElettrico,TermosifoneElettricoGradino,confronto,Serbatoio}</Output>
    </GraphCell>
    <GraphCell style="Graph" closed="false">
      <Input>model TermosifoneElettricoGradino2
 extends TermosifoneElettrico(deltaQ=1000);
end  TermosifoneElettricoGradino2;</Input>
      <Output>{TermosifoneElettricoGradino2,TermosifoneElettrico,TermosifoneElettricoGradino,confronto,Serbatoio}</Output>
    </GraphCell>
    <GraphCell style="Graph" closed="false">
      <Input>simulate(TermosifoneElettricoGradino2, startTime=-100, stopTime=3600 );</Input>
      <Output>[done]</Output>
    </GraphCell>
    <GraphCell style="Graph" closed="false">
      <OMCPlot PlotType="0" XRangeMin="0" Title="Plot by OpenModelica" LogX="false" XRangeMax="0" Grid="true" LogY="false" YRangeMin="0" YRangeMax="0" YLabel="" Legend="true" XLabel="time">
        <Curve Title="T" Visible="true" XData="" YData="" Color="4294901760"/>
      </OMCPlot>
      <Input>plot(T)</Input>
      <Output>[done]</Output>
    </GraphCell>
  </GroupCell>
</Notebook>
