<!DOCTYPE OMNotebook>
<Notebook>
 <GroupCell closed="false" >
  <InputCell style="Input" closed="false" >
   <Input>loadModel(Modelica)</Input>
   <Output>true</Output>
  </InputCell>
  <InputCell style="Input" closed="false" >
   <Input>model test
  Modelica.Blocks.Sources.Sine sine;
  Modelica.Blocks.Discrete.Sampler sampler(samplePeriod=0.05);
equation
  connect(sine.y,sampler.u);
end test;</Input>
   <Output>Ok</Output>
  </InputCell>
  <InputCell style="Input" closed="false" >
   <Input>simulate(test,stopTime=5)</Input>
   <Output>record
    resultFile = "test_res.plt"
end record</Output>
  </InputCell>
  <InputCell style="Input" closed="false" >
   <Input>plot({sine.y,sampler.y})</Input>
   <Output>&lt;html>&lt;head>&lt;meta name="qrichtext" content="1" />&lt;/head>&lt;body style=" white-space: pre-wrap; font-family:MS Shell Dlg; font-size:8.25pt; font-weight:400; font-style:normal; text-decoration:none;">&lt;p style=" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; font-family:Courier New; font-size:11pt; color:#000000;">&lt;img src="file:///C:/OpenModelica1.4.3/bin/OMNoteboook_tempfiles/14.png" width="492" height="250" />&lt;/p>&lt;/body>&lt;/html></Output>
   <Image name="file:///C:/OpenModelica1.4.3/bin/OMNoteboook_tempfiles/14.png" ></Image>
  </InputCell>
 </GroupCell>
</Notebook>
