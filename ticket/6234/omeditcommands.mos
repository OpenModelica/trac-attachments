parseString("within AerosolSystem.Components.BasicElements;

model MultiFlowLumpedVolume
  outer Wall wall if useWall;
  
  extends AerosolSystem.Components.BaseClasses.AerosolState(
    prel(start = prelstart),
    h(start = hstart),
    T(start = Tstart),
    Y(start = Ystart),
    Z(start = Zstart),
    N(start = Nstart)
  );
    
  replaceable model WallHeatTransfer = Thermal.HeatTransfer.IdealTransfer2T
    constrainedby Thermal.Interfaces.WallSingleT "wall heat transfer model"
    annotation(choicesAllMatching = true);
  WallHeatTransfer wallHeatTransfer(
    redeclare package CQValPkg = CQValPkg,
    CQVal = CQVal,
    Qw = Qw,
    Tw = Tw,
    T = T
  ) "wall heat transfer instance";  
      
  replaceable model Nucl = AerosolModels.NullModel.Nucleation 
    constrainedby AerosolModels.Interfaces.Nucleation "Nucleation model class"
    annotation(choicesAllMatching = true);   
  Nucl nucl(
    redeclare package CQValPkg = CQValPkg,
    CQVal = CQVal,
    p = p,
    h = h,
    Y = Yreg,
    Z = Zreg,
    N = Nreg,
    T = T  
  ) "Nucleation model instance"; 
  
  replaceable model EvapCond = AerosolModels.NullModel.EvaporationCondensation 
    constrainedby AerosolModels.Interfaces.EvaporationCondensation "Evaporation/Condensation model class"
    annotation(choicesAllMatching = true);   
  EvapCond evapCond(
    redeclare package CQValPkg = CQValPkg,
    CQVal = CQVal,
    p = p,
    h = h,
    Y = Yreg,
    Z = Zreg,
    N = Nreg,
    T = T
  ) "Evaporation/Condensation model instance";

  replaceable model Coal = AerosolModels.NullModel.Coalescence 
    constrainedby AerosolModels.Interfaces.Coalescence "Coalescence model class"
    annotation(choicesAllMatching = true);   
  Coal coal(
    redeclare package CQValPkg = CQValPkg,
    CQVal = CQVal,
    p = p,
    h = h,
    Y = Yreg,
    Z = Zreg,
    N = Nreg,
    T = T  
  ) "Coalescence model instance";   

  replaceable model Absor = AerosolModels.NullModel.Absorption 
    constrainedby AerosolModels.Interfaces.Absorption "Absorption model class"
    annotation(choicesAllMatching = true);   
  Absor absor(
    redeclare package CQValPkg = CQValPkg,
    CQVal = CQVal,
    Vint = Vint,
    dh = dh,
    Lv = Lv,
    p = p,
    h = h,
    Y = Yreg,
    Z = Zreg,
    N = Nreg,
    T = T    
  ) "Coalescence model instance";     
  
  replaceable model DepositionSedimentation = AerosolModels.DepositionModels.NullModel.DepositionSedimentation 
    constrainedby AerosolModels.DepositionModels.Interfaces.DepositionSedimentation "Sedimentation model class"
    annotation(choicesAllMatching = true);   

  replaceable model DepositionBrownian = AerosolModels.DepositionModels.NullModel.DepositionBrownian
    constrainedby AerosolModels.DepositionModels.Interfaces.DepositionBrownian "Brownian deposition model class"
    annotation(choicesAllMatching = true);   

  replaceable model DepositionImpaction = AerosolModels.DepositionModels.NullModel.DepositionImpaction 
    constrainedby AerosolModels.DepositionModels.Interfaces.DepositionImpaction "Impaction model class"
    annotation(choicesAllMatching = true);   

  replaceable model DepositionGeneral = AerosolModels.DepositionModels.NullModel.DepositionGeneral
    constrainedby AerosolModels.DepositionModels.Interfaces.DepositionGeneral "General deposition model class"
    annotation(choicesAllMatching = true);   
  
  AerosolModels.DepositionModels.Common.DepositionLayer depos(
    redeclare model DepositionSedimentation = DepositionSedimentation,
    redeclare model DepositionBrownian = DepositionBrownian,
    redeclare model DepositionImpaction = DepositionImpaction,
    redeclare model DepositionGeneral = DepositionGeneral,
    redeclare package CQValPkg = CQValPkg,
    CQVal = CQVal,
    Nw = Nw,
    ws = ws,
    Vint = Vint,
    dh = dh,
    Lv = Lv,
    alphag = alphag,
    p = p,
    h = h,
    Y = Yreg,
    Z = Zreg,
    N = Nreg,    
    T = T    
  );

  package CQValPkg = CommonQuantitiesValuesPkg(Ns=Ns,Nddc=Nddc);
  CQValPkg.CommonQuantitiesValues CQVal = CQCalcModule.CQVal;

  constant CommonQuantitiesReq CQReq(
    roMixReq = true
  ) "Common quantities calculation request";

  AerosolModels.Common.CommonQuantitiesCalc CQCalcModule(
    redeclare package CQValPkg = CQValPkg,
    CQReqArray = cat(1,{CQReq},
                       wallHeatTransfer.CQReqArray,
                       nucl.CQReqArray,
                       evapCond.CQReqArray,
                       coal.CQReqArray,
                       absor.CQReqArray,
                       depos.CQReqArray
                     ),
    p = p,
    h = h,
    Y = Yreg,
    Z = Zreg,
    N = Nreg,    
    T = T      
  ) "Common quantities calculation module";

  constant Integer Nw = 2 "number of flowrates to be considered for deposition calculation" annotation(Evaluate = true);

  parameter MassFlowRate MassFlowRateLocNom = Types.MassFlowRateNom "flowrate local nominal value" annotation(
  Dialog(tab = "Local nominal values"));  
  parameter Boolean useConstantTemperature = system.useConstantTemperature "true, if constant temperature is considered in volumes";
  parameter Boolean useIncompressibleFluid = system.useIncompressibleFluid "true, if incompressible fluid is considered in volumes for energy balance";
  parameter Boolean useWall = system.useWall "true, if wall interface is used";
  parameter Real NwB = 2 "number of symmetry flowrates" annotation(Evaluate = true);
  parameter Boolean useExtDeltaVolIn = false "use external input deltaVolIn to prescribe the internal volume variation (PerUnit)" annotation(
    choices(checkBox = true)); 
  parameter Boolean useEqSpring = false "use wall equivalent spring (it is ignored when the internal volume is prescribed)" annotation(
    Dialog(enable = not useExtDeltaVolIn), choices(checkBox = true));
  parameter Length dh "Hydraulic diameter";
  parameter Length LvRef "reference volume eqivalent length";
  parameter Angle alphag = 90*pi/180 "Volume slope";
  parameter Pressure Ksdh = 1e-1 "Ratio Ks/dh where Ks is the equivalent spring constant and dh is the Hydraulic diameter";
  parameter RelativePressure prelstart = system.prelstart "Relative Pressure start value" annotation(
    Dialog(tab = "Initialization"));
  parameter Temperature Tstart = system.Tstart "Temperature start value" annotation(
    Dialog(tab = "Initialization"));
  parameter MassFraction[Ns] Ystart = system.Ystart "Start value of mixture substances vapour mass fractions" annotation(
    Dialog(tab = "Initialization"));
  parameter MassFraction[Ns,Nddc] Zstart = system.Zstart "Start value of mixture substances liquid mass fractions" annotation(
    Dialog(tab = "Initialization"));
  parameter DropletNumberVolDensity[Nddc] Nstart = system.Nstart "Start value of droplet number volumetric density for each diameter class" annotation(
    Dialog(tab = "Initialization"));
  parameter Boolean usePrelstart = true "use initial equation for relative pressure" annotation(
    Dialog(tab = "Initialization"), choices(checkBox = true));
  final parameter SpecificHeatCapacity cpMixstart = system.Medium.Common.specificHeatCapacity(system.pref+prelstart,Tstart,Ystart,Zstart,Nstart);
  final parameter SpecificEnthalpy hstart = cpMixstart*Tstart;
  final parameter Density roMixStart = system.Medium.Common.density(system.pref+prelstart,Tstart,Ystart,Zstart,Nstart);
  final parameter Area Sw = 0.25*pi*dh^2 "volume equivalent cross section";
  final parameter Volume VintRef = Sw*LvRef "reference internal volume";
  final parameter TranslationalSpringConstant Ks = Ksdh*dh "equivalent spring constant";

  // state regularization thresholds
  parameter Boolean useStateRegY = system.useStateRegY "use regularized Y for aerosol models and common properties calculation" annotation(
  Dialog(tab = "State regularization thresolds"));
  parameter Boolean useStateRegZ = system.useStateRegZ "use regularized Z for aerosol models and common properties calculation" annotation(
  Dialog(tab = "State regularization thresolds"));
  parameter Boolean useStateRegN = system.useStateRegN "use regularized N for aerosol models and common properties calculation" annotation(
  Dialog(tab = "State regularization thresolds"));
  parameter MassFraction YregSwitchPoint[Ns] = system.YregSwitchPoint "switch point" annotation(
  Dialog(tab = "State regularization thresolds"));
  parameter MassFraction YregIntTrsh[Ns] = system.YregIntTrsh "interval treshold" annotation(
  Dialog(tab = "State regularization thresolds"));
  parameter MassFraction YregMinVal[Ns] = system.YregMinVal "asymptotic min value" annotation(
  Dialog(tab = "State regularization thresolds"));
  parameter MassFraction ZregSwitchPoint[Ns,Nddc] = system.ZregSwitchPoint "switch point" annotation(
  Dialog(tab = "State regularization thresolds"));
  parameter MassFraction ZregIntTrsh[Ns,Nddc] = system.ZregIntTrsh "interval treshold" annotation(
  Dialog(tab = "State regularization thresolds"));
  parameter MassFraction ZregMinVal[Ns,Nddc] = system.ZregMinVal "asymptotic min value" annotation(
  Dialog(tab = "State regularization thresolds"));
  parameter DropletNumberVolDensity NregSwitchPoint[Nddc] = system.NregSwitchPoint "switch point" annotation(
  Dialog(tab = "State regularization thresolds"));
  parameter DropletNumberVolDensity NregIntTrsh[Nddc] = system.NregIntTrsh "interval treshold" annotation(
  Dialog(tab = "State regularization thresolds"));
  parameter DropletNumberVolDensity NregMinVal[Nddc] = system.NregMinVal "asymptotic minimum value" annotation(
  Dialog(tab = "State regularization thresolds"));
  
  Pressure p = system.pref + prel "Mixture pressure";
  MassFlowRate wa(nominal = MassFlowRateLocNom), wb(nominal = MassFlowRateLocNom/NwB) "mixture flowrate at ports";
  SpecificEnthalpy ha, hb "mixture specific enthalpy at ports";
  HeatFlowRate Qw "Heat flowrate through wall";
  Temperature Tw "wall temperature";
  MassFraction Ya[Ns], Yb[Ns] "Mixture vapour mass fractions at ports";
  MassFraction Za[Ns,Nddc], Zb[Ns,Nddc] "Mixture liquid mass fractions for each diameter class at ports";
  DropletNumberMassDensity Nma[Nddc], Nmb[Nddc] "Droplet number mass density for each diameter class at ports";
  MassFlowRate ws[Nw](each nominal = MassFlowRateLocNom) = {wa, NwB*wb} "Mass flow rate at external boundary ports for deposition calculation";
  
  Mass Mtot(start = roMixStart*VintRef, nominal = roMixStart*VintRef, stateSelect = StateSelect.avoid) "Total mass inside volume";
  Density roMix(start = roMixStart) "mixture density";
  SpecificHeatCapacity cpMix "mixture specific heat capacity";
  Volume Vint(start = VintRef, nominal = VintRef) "internal volume";
  PerUnit SumYZ = sum(Y) + sum(Z);
  Length Lv(start = LvRef) "volume equivalent length";  

  // regularized state
  MassFraction[Ns] Yreg(each stateSelect = StateSelect.avoid) "Mixture substances vapour mass fractions";
  MassFraction[Ns,Nddc] Zreg(each stateSelect = StateSelect.avoid) "Mixture substances liquid mass fractions for each diameter class";
  DropletNumberVolDensity[Nddc] Nreg(each stateSelect = StateSelect.avoid) "Droplet number volumetric density for each diameter class";
    
  AerosolSystem.Components.Interfaces.AerosolPort portA(Ns=Ns, Nddc=Nddc, w(nominal = MassFlowRateLocNom)) annotation(
    Placement(visible = true, transformation(origin = {-100, 0}, extent = {{-20, -10}, {20, 10}}, rotation = 0), iconTransformation(origin = {-100, 0}, extent = {{-10, -10}, {10, 10}}, rotation = 0)));
  AerosolSystem.Components.Interfaces.AerosolPort portB(Ns=Ns, Nddc=Nddc, w(nominal = MassFlowRateLocNom/NwB)) annotation(
    Placement(visible = true, transformation(origin = {98, 0}, extent = {{-20, -10}, {20, 10}}, rotation = 0), iconTransformation(origin = {100, 0}, extent = {{-10, -10}, {10, 10}}, rotation = 0)));
  Modelica.Thermal.HeatTransfer.Interfaces.HeatPort_a portQ annotation(
    Placement(visible = true, transformation(origin = {2, 88}, extent = {{-10, -10}, {10, 10}}, rotation = 0), iconTransformation(origin = {0, 100}, extent = {{-10, -10}, {10, 10}}, rotation = 0)));
  Modelica.Blocks.Interfaces.RealInput deltaVolInpu(unit="1") = deltaVintRefpu if useExtDeltaVolIn "prescribed variation of internal reference volume (PerUnit)" annotation(
    Placement(visible = true, transformation(origin = {-128, 88}, extent = {{-20, -20}, {20, 20}}, rotation = 0), iconTransformation(origin = {-40, 100}, extent = {{-10, -10}, {10, 10}}, rotation = -90)));
  AerosolSystem.Components.Interfaces.ToWallLayer toWallLayer if useWall "output to wall interface"; 
  
  
protected
  PerUnit deltaVintRefpu "prescribed variation of internal reference volume (PerUnit)";
  
equation
  // heat transfer
  connect(portQ, wallHeatTransfer.wallPort) annotation(
    Line);
  
  // conditional inputs and flags
  if useExtDeltaVolIn then
    Lv = Vint/Sw;
    Vint = (1+deltaVintRefpu)*VintRef;
  else  
    if useEqSpring then
      deltaVintRefpu = 0;
      Sw*prel = Ks*(Lv-LvRef);
      Vint = Sw*Lv;
    else
      deltaVintRefpu = 0;
      Lv = LvRef;
      Vint = VintRef;
    end if;
  end if;
    
  // mass balance
  Mtot = roMix*Vint;

  der(Mtot) = wa + NwB*wb - Vint*depos.Wdep - Vint*absor.Wabs "[kg/s]";
  der(Mtot*Y) = {wa*Ya[i] + NwB*wb*Yb[i] + Vint*sum(evapCond.Sec[i,j] for j in 1:Nddc) - Vint*sum(nucl.Snuc[i,j] for j in 1:Nddc) - Vint*absor.Sabs[i] for i in 1:Ns} "[kg/s]";
  der(Mtot*Z) = {{wa*Za[i,j] + NwB*wb*Zb[i,j] - Vint*evapCond.Sec[i,j] + Vint*nucl.Snuc[i,j] - Vint*depos.Sdep[i,j] for j in 1:Nddc} for i in 1:Ns} "[kg/s]";
  der(Vint*N) = {wa*Nma[j] + NwB*wb*Nmb[j] - Vint*evapCond.Jev[j] + Vint*nucl.Jn[j] - Vint*coal.Jc[j] - Vint*depos.Jdep[j] for j in 1:Nddc}  "[#/s]";  
  
  // energy balance
  if useConstantTemperature then
    T = Tstart;
    h = cpMix*T;
  elseif useIncompressibleFluid then
    der(Mtot*h) = wa*ha + NwB*wb*hb + Qw - Vint*depos.Wdep*h - Vint*absor.Wabs*h;
    h = cpMix*T;
  else  
    der(Mtot*h - p*Vint) = wa*ha + NwB*wb*hb + Qw - Vint*depos.Wdep*h;
    h = cpMix*T "TODO fix enthalpy calculation";
  end if;  
  
  // properties
  cpMix = system.Medium.Common.specificHeatCapacity(p,T,Yreg,Zreg,Nreg); 
  roMix = CQVal.roMix;

  //boundary conditions
  portA.prel = prel;
  wa = portA.w;
  portB.prel = prel;
  wb = portB.w;
  
  // regularized state
  if useStateRegY then
    Yreg = AerosolSystem.Components.Functions.regSin2(
      Y,
      YregIntTrsh,
      YregMinVal,
      Y,
      YregSwitchPoint
    );
  else
    Yreg = Y;  
  end if;

  if useStateRegZ then  
    Zreg = AerosolSystem.Components.Functions.regSin2(
      Z,
      ZregIntTrsh,
      ZregMinVal,
      Z,
      ZregSwitchPoint
    );
  else
    Zreg = Z;  
  end if;

  if useStateRegN then    
    Nreg = AerosolSystem.Components.Functions.regSin2(
      N,
      NregIntTrsh,
      NregMinVal,
      N,
      NregSwitchPoint
    );
  else
    Nreg = N;
  end if;
  
  //stream connectors
  portA.h = cpMix*T;
  portA.Y = Y;
  portA.Z = Z;
  portA.Nm = N/roMix;
  ha = noEvent(actualStream(portA.h));
  Ya = noEvent(actualStream(portA.Y));
  Za = noEvent(actualStream(portA.Z));  
  Nma = noEvent(actualStream(portA.Nm));
    
  portB.h = cpMix*T;
  portB.Y = Y;
  portB.Z = Z;
  portB.Nm = N/roMix;
  hb = noEvent(actualStream(portB.h));
  Yb = noEvent(actualStream(portB.Y));
  Zb = noEvent(actualStream(portB.Z));  
  Nmb = noEvent(actualStream(portB.Nm));

initial equation
  if usePrelstart then
    prel = prelstart;
  end if; 
      
  T = Tstart;
  Y = Ystart;
  Z = Zstart;
  N = Nstart;
  
annotation(
    Icon(coordinateSystem(grid = {0.1, 0.1}, initialScale = 0.1), graphics = {Rectangle(fillColor = {164, 230, 244}, fillPattern = FillPattern.Sphere, extent = {{-100, 100}, {100, -100}}, radius = 50), Text(origin = {-1, -120}, lineColor = {0, 0, 255}, extent = {{-59, 14}, {59, -14}}, textString = "%name"), Text(origin = {0, -2},lineColor = {255, 255, 255}, extent = {{-70, 72}, {72, -68}}, textString = "V")}),
    Diagram(coordinateSystem(extent = {{-200, -100}, {200, 100}}, grid = {0.5, 0.5})));

end MultiFlowLumpedVolume;","/mnt/myData/encData/z_encWorkData/Dynamica-Activities/PMI.003-LibAerosolExtension/Libraries/aerosolsystem/AerosolSystem/Components/BasicElements/MultiFlowLumpedVolume.mo"); getErrorString();
errors:=getMessagesStringInternal(); getErrorString();
size(errors,1); getErrorString();
loadString("within AerosolSystem.Components.BasicElements;

model MultiFlowLumpedVolume
  outer Wall wall if useWall;
  
  extends AerosolSystem.Components.BaseClasses.AerosolState(
    prel(start = prelstart),
    h(start = hstart),
    T(start = Tstart),
    Y(start = Ystart),
    Z(start = Zstart),
    N(start = Nstart)
  );
    
  replaceable model WallHeatTransfer = Thermal.HeatTransfer.IdealTransfer2T
    constrainedby Thermal.Interfaces.WallSingleT "wall heat transfer model"
    annotation(choicesAllMatching = true);
  WallHeatTransfer wallHeatTransfer(
    redeclare package CQValPkg = CQValPkg,
    CQVal = CQVal,
    Qw = Qw,
    Tw = Tw,
    T = T
  ) "wall heat transfer instance";  
      
  replaceable model Nucl = AerosolModels.NullModel.Nucleation 
    constrainedby AerosolModels.Interfaces.Nucleation "Nucleation model class"
    annotation(choicesAllMatching = true);   
  Nucl nucl(
    redeclare package CQValPkg = CQValPkg,
    CQVal = CQVal,
    p = p,
    h = h,
    Y = Yreg,
    Z = Zreg,
    N = Nreg,
    T = T  
  ) "Nucleation model instance"; 
  
  replaceable model EvapCond = AerosolModels.NullModel.EvaporationCondensation 
    constrainedby AerosolModels.Interfaces.EvaporationCondensation "Evaporation/Condensation model class"
    annotation(choicesAllMatching = true);   
  EvapCond evapCond(
    redeclare package CQValPkg = CQValPkg,
    CQVal = CQVal,
    p = p,
    h = h,
    Y = Yreg,
    Z = Zreg,
    N = Nreg,
    T = T
  ) "Evaporation/Condensation model instance";

  replaceable model Coal = AerosolModels.NullModel.Coalescence 
    constrainedby AerosolModels.Interfaces.Coalescence "Coalescence model class"
    annotation(choicesAllMatching = true);   
  Coal coal(
    redeclare package CQValPkg = CQValPkg,
    CQVal = CQVal,
    p = p,
    h = h,
    Y = Yreg,
    Z = Zreg,
    N = Nreg,
    T = T  
  ) "Coalescence model instance";   

  replaceable model Absor = AerosolModels.NullModel.Absorption 
    constrainedby AerosolModels.Interfaces.Absorption "Absorption model class"
    annotation(choicesAllMatching = true);   
  Absor absor(
    redeclare package CQValPkg = CQValPkg,
    CQVal = CQVal,
    Vint = Vint,
    dh = dh,
    Lv = Lv,
    p = p,
    h = h,
    Y = Yreg,
    Z = Zreg,
    N = Nreg,
    T = T    
  ) "Coalescence model instance";     
  
  replaceable model DepositionSedimentation = AerosolModels.DepositionModels.NullModel.DepositionSedimentation 
    constrainedby AerosolModels.DepositionModels.Interfaces.DepositionSedimentation "Sedimentation model class"
    annotation(choicesAllMatching = true);   

  replaceable model DepositionBrownian = AerosolModels.DepositionModels.NullModel.DepositionBrownian
    constrainedby AerosolModels.DepositionModels.Interfaces.DepositionBrownian "Brownian deposition model class"
    annotation(choicesAllMatching = true);   

  replaceable model DepositionImpaction = AerosolModels.DepositionModels.NullModel.DepositionImpaction 
    constrainedby AerosolModels.DepositionModels.Interfaces.DepositionImpaction "Impaction model class"
    annotation(choicesAllMatching = true);   

  replaceable model DepositionGeneral = AerosolModels.DepositionModels.NullModel.DepositionGeneral
    constrainedby AerosolModels.DepositionModels.Interfaces.DepositionGeneral "General deposition model class"
    annotation(choicesAllMatching = true);   
  
  AerosolModels.DepositionModels.Common.DepositionLayer depos(
    redeclare model DepositionSedimentation = DepositionSedimentation,
    redeclare model DepositionBrownian = DepositionBrownian,
    redeclare model DepositionImpaction = DepositionImpaction,
    redeclare model DepositionGeneral = DepositionGeneral,
    redeclare package CQValPkg = CQValPkg,
    CQVal = CQVal,
    Nw = Nw,
    ws = ws,
    Vint = Vint,
    dh = dh,
    Lv = Lv,
    alphag = alphag,
    p = p,
    h = h,
    Y = Yreg,
    Z = Zreg,
    N = Nreg,    
    T = T    
  );

  package CQValPkg = CommonQuantitiesValuesPkg(Ns=Ns,Nddc=Nddc);
  CQValPkg.CommonQuantitiesValues CQVal = CQCalcModule.CQVal;

  constant CommonQuantitiesReq CQReq(
    roMixReq = true
  ) "Common quantities calculation request";

  AerosolModels.Common.CommonQuantitiesCalc CQCalcModule(
    redeclare package CQValPkg = CQValPkg,
    CQReqArray = cat(1,{CQReq},
                       wallHeatTransfer.CQReqArray,
                       nucl.CQReqArray,
                       evapCond.CQReqArray,
                       coal.CQReqArray,
                       absor.CQReqArray,
                       depos.CQReqArray
                     ),
    p = p,
    h = h,
    Y = Yreg,
    Z = Zreg,
    N = Nreg,    
    T = T      
  ) "Common quantities calculation module";

  constant Integer Nw = 2 "number of flowrates to be considered for deposition calculation" annotation(Evaluate = true);

  parameter MassFlowRate MassFlowRateLocNom = Types.MassFlowRateNom "flowrate local nominal value" annotation(
  Dialog(tab = "Local nominal values"));  
  parameter Boolean useConstantTemperature = system.useConstantTemperature "true, if constant temperature is considered in volumes";
  parameter Boolean useIncompressibleFluid = system.useIncompressibleFluid "true, if incompressible fluid is considered in volumes for energy balance";
  parameter Boolean useWall = system.useWall "true, if wall interface is used";
  parameter Real NwB = 2 "number of symmetry flowrates" annotation(Evaluate = true);
  parameter Boolean useExtDeltaVolIn = false "use external input deltaVolIn to prescribe the internal volume variation (PerUnit)" annotation(
    choices(checkBox = true)); 
  parameter Boolean useEqSpring = false "use wall equivalent spring (it is ignored when the internal volume is prescribed)" annotation(
    Dialog(enable = not useExtDeltaVolIn), choices(checkBox = true));
  parameter Length dh "Hydraulic diameter";
  parameter Length LvRef "reference volume eqivalent length";
  parameter Angle alphag = 90*pi/180 "Volume slope";
  parameter Pressure Ksdh = 1e-1 "Ratio Ks/dh where Ks is the equivalent spring constant and dh is the Hydraulic diameter";
  parameter RelativePressure prelstart = system.prelstart "Relative Pressure start value" annotation(
    Dialog(tab = "Initialization"));
  parameter Temperature Tstart = system.Tstart "Temperature start value" annotation(
    Dialog(tab = "Initialization"));
  parameter MassFraction[Ns] Ystart = system.Ystart "Start value of mixture substances vapour mass fractions" annotation(
    Dialog(tab = "Initialization"));
  parameter MassFraction[Ns,Nddc] Zstart = system.Zstart "Start value of mixture substances liquid mass fractions" annotation(
    Dialog(tab = "Initialization"));
  parameter DropletNumberVolDensity[Nddc] Nstart = system.Nstart "Start value of droplet number volumetric density for each diameter class" annotation(
    Dialog(tab = "Initialization"));
  parameter Boolean usePrelstart = true "use initial equation for relative pressure" annotation(
    Dialog(tab = "Initialization"), choices(checkBox = true));
  final parameter SpecificHeatCapacity cpMixstart = system.Medium.Common.specificHeatCapacity(system.pref+prelstart,Tstart,Ystart,Zstart,Nstart);
  final parameter SpecificEnthalpy hstart = cpMixstart*Tstart;
  final parameter Density roMixStart = system.Medium.Common.density(system.pref+prelstart,Tstart,Ystart,Zstart,Nstart);
  final parameter Area Sw = 0.25*pi*dh^2 "volume equivalent cross section";
  final parameter Volume VintRef = Sw*LvRef "reference internal volume";
  final parameter TranslationalSpringConstant Ks = Ksdh*dh "equivalent spring constant";

  // state regularization thresholds
  parameter Boolean useStateRegY = system.useStateRegY "use regularized Y for aerosol models and common properties calculation" annotation(
  Dialog(tab = "State regularization thresolds"));
  parameter Boolean useStateRegZ = system.useStateRegZ "use regularized Z for aerosol models and common properties calculation" annotation(
  Dialog(tab = "State regularization thresolds"));
  parameter Boolean useStateRegN = system.useStateRegN "use regularized N for aerosol models and common properties calculation" annotation(
  Dialog(tab = "State regularization thresolds"));
  parameter MassFraction YregSwitchPoint[Ns] = system.YregSwitchPoint "switch point" annotation(
  Dialog(tab = "State regularization thresolds"));
  parameter MassFraction YregIntTrsh[Ns] = system.YregIntTrsh "interval treshold" annotation(
  Dialog(tab = "State regularization thresolds"));
  parameter MassFraction YregMinVal[Ns] = system.YregMinVal "asymptotic min value" annotation(
  Dialog(tab = "State regularization thresolds"));
  parameter MassFraction ZregSwitchPoint[Ns,Nddc] = system.ZregSwitchPoint "switch point" annotation(
  Dialog(tab = "State regularization thresolds"));
  parameter MassFraction ZregIntTrsh[Ns,Nddc] = system.ZregIntTrsh "interval treshold" annotation(
  Dialog(tab = "State regularization thresolds"));
  parameter MassFraction ZregMinVal[Ns,Nddc] = system.ZregMinVal "asymptotic min value" annotation(
  Dialog(tab = "State regularization thresolds"));
  parameter DropletNumberVolDensity NregSwitchPoint[Nddc] = system.NregSwitchPoint "switch point" annotation(
  Dialog(tab = "State regularization thresolds"));
  parameter DropletNumberVolDensity NregIntTrsh[Nddc] = system.NregIntTrsh "interval treshold" annotation(
  Dialog(tab = "State regularization thresolds"));
  parameter DropletNumberVolDensity NregMinVal[Nddc] = system.NregMinVal "asymptotic minimum value" annotation(
  Dialog(tab = "State regularization thresolds"));
  
  Pressure p = system.pref + prel "Mixture pressure";
  MassFlowRate wa(nominal = MassFlowRateLocNom), wb(nominal = MassFlowRateLocNom/NwB) "mixture flowrate at ports";
  SpecificEnthalpy ha, hb "mixture specific enthalpy at ports";
  HeatFlowRate Qw "Heat flowrate through wall";
  Temperature Tw "wall temperature";
  MassFraction Ya[Ns], Yb[Ns] "Mixture vapour mass fractions at ports";
  MassFraction Za[Ns,Nddc], Zb[Ns,Nddc] "Mixture liquid mass fractions for each diameter class at ports";
  DropletNumberMassDensity Nma[Nddc], Nmb[Nddc] "Droplet number mass density for each diameter class at ports";
  MassFlowRate ws[Nw](each nominal = MassFlowRateLocNom) = {wa, NwB*wb} "Mass flow rate at external boundary ports for deposition calculation";
  
  Mass Mtot(start = roMixStart*VintRef, nominal = roMixStart*VintRef, stateSelect = StateSelect.avoid) "Total mass inside volume";
  Density roMix(start = roMixStart) "mixture density";
  SpecificHeatCapacity cpMix "mixture specific heat capacity";
  Volume Vint(start = VintRef, nominal = VintRef) "internal volume";
  PerUnit SumYZ = sum(Y) + sum(Z);
  Length Lv(start = LvRef) "volume equivalent length";  

  // regularized state
  MassFraction[Ns] Yreg(each stateSelect = StateSelect.avoid) "Mixture substances vapour mass fractions";
  MassFraction[Ns,Nddc] Zreg(each stateSelect = StateSelect.avoid) "Mixture substances liquid mass fractions for each diameter class";
  DropletNumberVolDensity[Nddc] Nreg(each stateSelect = StateSelect.avoid) "Droplet number volumetric density for each diameter class";
    
  AerosolSystem.Components.Interfaces.AerosolPort portA(Ns=Ns, Nddc=Nddc, w(nominal = MassFlowRateLocNom)) annotation(
    Placement(visible = true, transformation(origin = {-100, 0}, extent = {{-20, -10}, {20, 10}}, rotation = 0), iconTransformation(origin = {-100, 0}, extent = {{-10, -10}, {10, 10}}, rotation = 0)));
  AerosolSystem.Components.Interfaces.AerosolPort portB(Ns=Ns, Nddc=Nddc, w(nominal = MassFlowRateLocNom/NwB)) annotation(
    Placement(visible = true, transformation(origin = {98, 0}, extent = {{-20, -10}, {20, 10}}, rotation = 0), iconTransformation(origin = {100, 0}, extent = {{-10, -10}, {10, 10}}, rotation = 0)));
  Modelica.Thermal.HeatTransfer.Interfaces.HeatPort_a portQ annotation(
    Placement(visible = true, transformation(origin = {2, 88}, extent = {{-10, -10}, {10, 10}}, rotation = 0), iconTransformation(origin = {0, 100}, extent = {{-10, -10}, {10, 10}}, rotation = 0)));
  Modelica.Blocks.Interfaces.RealInput deltaVolInpu(unit="1") = deltaVintRefpu if useExtDeltaVolIn "prescribed variation of internal reference volume (PerUnit)" annotation(
    Placement(visible = true, transformation(origin = {-128, 88}, extent = {{-20, -20}, {20, 20}}, rotation = 0), iconTransformation(origin = {-40, 100}, extent = {{-10, -10}, {10, 10}}, rotation = -90)));
  AerosolSystem.Components.Interfaces.ToWallLayer toWallLayer if useWall "output to wall interface"; 
  
  
protected
  PerUnit deltaVintRefpu "prescribed variation of internal reference volume (PerUnit)";
  
equation
  // heat transfer
  connect(portQ, wallHeatTransfer.wallPort) annotation(
    Line);
  
  // conditional inputs and flags
  if useExtDeltaVolIn then
    Lv = Vint/Sw;
    Vint = (1+deltaVintRefpu)*VintRef;
  else  
    if useEqSpring then
      deltaVintRefpu = 0;
      Sw*prel = Ks*(Lv-LvRef);
      Vint = Sw*Lv;
    else
      deltaVintRefpu = 0;
      Lv = LvRef;
      Vint = VintRef;
    end if;
  end if;
    
  // mass balance
  Mtot = roMix*Vint;

  der(Mtot) = wa + NwB*wb - Vint*depos.Wdep - Vint*absor.Wabs "[kg/s]";
  der(Mtot*Y) = {wa*Ya[i] + NwB*wb*Yb[i] + Vint*sum(evapCond.Sec[i,j] for j in 1:Nddc) - Vint*sum(nucl.Snuc[i,j] for j in 1:Nddc) - Vint*absor.Sabs[i] for i in 1:Ns} "[kg/s]";
  der(Mtot*Z) = {{wa*Za[i,j] + NwB*wb*Zb[i,j] - Vint*evapCond.Sec[i,j] + Vint*nucl.Snuc[i,j] - Vint*depos.Sdep[i,j] for j in 1:Nddc} for i in 1:Ns} "[kg/s]";
  der(Vint*N) = {wa*Nma[j] + NwB*wb*Nmb[j] - Vint*evapCond.Jev[j] + Vint*nucl.Jn[j] - Vint*coal.Jc[j] - Vint*depos.Jdep[j] for j in 1:Nddc}  "[#/s]";  
  
  // energy balance
  if useConstantTemperature then
    T = Tstart;
    h = cpMix*T;
  elseif useIncompressibleFluid then
    der(Mtot*h) = wa*ha + NwB*wb*hb + Qw - Vint*depos.Wdep*h - Vint*absor.Wabs*h;
    h = cpMix*T;
  else  
    der(Mtot*h - p*Vint) = wa*ha + NwB*wb*hb + Qw - Vint*depos.Wdep*h;
    h = cpMix*T "TODO fix enthalpy calculation";
  end if;  
  
  // properties
  cpMix = system.Medium.Common.specificHeatCapacity(p,T,Yreg,Zreg,Nreg); 
  roMix = CQVal.roMix;

  //boundary conditions
  portA.prel = prel;
  wa = portA.w;
  portB.prel = prel;
  wb = portB.w;
  
  // regularized state
  if useStateRegY then
    Yreg = AerosolSystem.Components.Functions.regSin2(
      Y,
      YregIntTrsh,
      YregMinVal,
      Y,
      YregSwitchPoint
    );
  else
    Yreg = Y;  
  end if;

  if useStateRegZ then  
    Zreg = AerosolSystem.Components.Functions.regSin2(
      Z,
      ZregIntTrsh,
      ZregMinVal,
      Z,
      ZregSwitchPoint
    );
  else
    Zreg = Z;  
  end if;

  if useStateRegN then    
    Nreg = AerosolSystem.Components.Functions.regSin2(
      N,
      NregIntTrsh,
      NregMinVal,
      N,
      NregSwitchPoint
    );
  else
    Nreg = N;
  end if;
  
  //stream connectors
  portA.h = cpMix*T;
  portA.Y = Y;
  portA.Z = Z;
  portA.Nm = N/roMix;
  ha = noEvent(actualStream(portA.h));
  Ya = noEvent(actualStream(portA.Y));
  Za = noEvent(actualStream(portA.Z));  
  Nma = noEvent(actualStream(portA.Nm));
    
  portB.h = cpMix*T;
  portB.Y = Y;
  portB.Z = Z;
  portB.Nm = N/roMix;
  hb = noEvent(actualStream(portB.h));
  Yb = noEvent(actualStream(portB.Y));
  Zb = noEvent(actualStream(portB.Z));  
  Nmb = noEvent(actualStream(portB.Nm));

initial equation
  if usePrelstart then
    prel = prelstart;
  end if; 
      
  T = Tstart;
  Y = Ystart;
  Z = Zstart;
  N = Nstart;
  
annotation(
    Icon(coordinateSystem(grid = {0.1, 0.1}, initialScale = 0.1), graphics = {Rectangle(fillColor = {164, 230, 244}, fillPattern = FillPattern.Sphere, extent = {{-100, 100}, {100, -100}}, radius = 50), Text(origin = {-1, -120}, lineColor = {0, 0, 255}, extent = {{-59, 14}, {59, -14}}, textString = "%name"), Text(origin = {0, -2},lineColor = {255, 255, 255}, extent = {{-70, 72}, {72, -68}}, textString = "V")}),
    Diagram(coordinateSystem(extent = {{-200, -100}, {200, 100}}, grid = {0.5, 0.5})));

end MultiFlowLumpedVolume;","/mnt/myData/encData/z_encWorkData/Dynamica-Activities/PMI.003-LibAerosolExtension/Libraries/aerosolsystem/AerosolSystem/Components/BasicElements/MultiFlowLumpedVolume.mo","UTF-8",false); getErrorString();
errors:=getMessagesStringInternal(); getErrorString();
size(errors,1); getErrorString();
getClassInformation(AerosolSystem.Components.BasicElements.MultiFlowLumpedVolume); getErrorString();
getInheritedClasses(AerosolSystem.Components.BasicElements.MultiFlowLumpedVolume); getErrorString();
errors:=getMessagesStringInternal(); getErrorString();
size(errors,1); getErrorString();
getNthInheritedClassIconMapAnnotation(AerosolSystem.Components.BasicElements.MultiFlowLumpedVolume, 1); getErrorString();
getNthInheritedClassDiagramMapAnnotation(AerosolSystem.Components.BasicElements.MultiFlowLumpedVolume, 1); getErrorString();
getIconAnnotation(AerosolSystem.Components.BasicElements.MultiFlowLumpedVolume); getErrorString();
errors:=getMessagesStringInternal(); getErrorString();
size(errors,1); getErrorString();
getElements(AerosolSystem.Components.BasicElements.MultiFlowLumpedVolume, useQuotes = true); getErrorString();
getElementAnnotations(AerosolSystem.Components.BasicElements.MultiFlowLumpedVolume); getErrorString();
getDiagramAnnotation(AerosolSystem.Components.BasicElements.MultiFlowLumpedVolume); getErrorString();
errors:=getMessagesStringInternal(); getErrorString();
size(errors,1); getErrorString();
getConnectionCount(AerosolSystem.Components.BasicElements.MultiFlowLumpedVolume); getErrorString();
getNthConnection(AerosolSystem.Components.BasicElements.MultiFlowLumpedVolume,1); getErrorString();
getNthConnectionAnnotation(AerosolSystem.Components.BasicElements.MultiFlowLumpedVolume, 1); getErrorString();
getTransitions(AerosolSystem.Components.BasicElements.MultiFlowLumpedVolume); getErrorString();
errors:=getMessagesStringInternal(); getErrorString();
size(errors,1); getErrorString();
getInitialStates(AerosolSystem.Components.BasicElements.MultiFlowLumpedVolume); getErrorString();
errors:=getMessagesStringInternal(); getErrorString();
size(errors,1); getErrorString();
getConnectionCount(AerosolSystem.Components.BasicElements.LumpedVolume); getErrorString();
