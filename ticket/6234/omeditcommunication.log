      NregIntTrsh,
      NregMinVal,
      N,
      NregSwitchPoint
    );
  else
    Nreg = N;
  end if;
  
  //stream connectors
  portA.h = cpMix*T;
  portA.Y = Y;
  portA.Z = Z;
  portA.Nm = N/roMix;
  ha = noEvent(actualStream(portA.h));
  Ya = noEvent(actualStream(portA.Y));
  Za = noEvent(actualStream(portA.Z));  
  Nma = noEvent(actualStream(portA.Nm));
    
  portB.h = cpMix*T;
  portB.Y = Y;
  portB.Z = Z;
