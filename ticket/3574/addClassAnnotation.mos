addClassAnnotation(In, annotate=Icon(graphics={Polygon(lineColor={0,0,127},fillColor={0,0,127},fillPattern=FillPattern.Solid,points={{0,50},{100,0},{0,-50},{0,50}}),Rectangle(lineColor={0,0,255},fillColor={0,0,255},extent={{-100,100},{100,-100}})}));
