echo(false);
s1 := "within ;
model Foo
  Real x(
    start = 0,
    fixed = true)
    \"Important variable\";
  Real y = 1e6
    \"Less important variable\";
equation
  der(x) = -x + 1; // some comment
end Foo;";
loadString(s1, "Foo.mo");
getErrorString();
addClassAnnotation(Foo, annotate=Icon(graphics={Rectangle(origin={-30,-43},extent={{-74,49},{74,-49}})}));
getErrorString();
answer := "within ;
model Foo
  Real x(
    start = 0,
    fixed = true)
    \"Important variable\";
  Real y = 1e6
    \"Less important variable\";
equation
  der(x) = -x + 1; // some comment
  annotation(Icon(graphics = {Rectangle(origin = {-30, -43}, extent = {{-74, 49}, {74, -49}})}));
end Foo;";
s2 := listFile(Foo);
print(s2);
if answer<>diffModelicaFileListings(s1, s2, OpenModelica.Scripting.DiffFormat.plain) then
  print("\nFailed \n");
  print("\nStart model:\n\n" + s1 + "\n");
  print("\nAdded rectangle+listFile:\n\n" + s2 + "\n");
  print("\nDiff:\n\n" + diffModelicaFileListings(s1, s2) + "\n");
  print(getErrorString());
end if;