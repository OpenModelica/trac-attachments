loadString("
model M
  type T = Real [3];
  function f
    input Real x;
    input T t_in;
    output Real y;
    external \"C\";
  annotation(Include = 
  \"
  #include <stddef.h>
  double f(double x, const double *t_in, size_t t_in_size)
  {
  return x + t_in[0] + t_in[1] + t_in[2];
  }
  \");
  end f;
  Real x;
equation
  x = f(time,{1, 2, 3}); 
end M;
");getErrorString();
simulate(M);getErrorString();