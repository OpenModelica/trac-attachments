setCommandLineOptions("+g=MetaModelica +d=noevalfunc");
loadString("
function f1
  input Integer x;
  output Integer y := x*2;
end f1;

function f2
  input Integer x;
  output Integer y;
algorithm
  y := f1(x);
end f2;");

for i in 1:20 loop
  print(intString(f2(i)) + "\n");
  // The following call will fail, but if it's removed the call above instead
  // fails in the second iteration.
  print(intString(f2(i)) + "\n");
end for;
getErrorString();
