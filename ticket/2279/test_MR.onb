<!DOCTYPE OMNotebook>
<Notebook>
  <GroupCell closed="false">
    <GraphCell style="Graph" closed="false">
      <Input>cd("C:\\Users\\eypma\\workspace\\NoiseModel\\Random")</Input>
      <Output>"C:/Users/eypma/workspace/NoiseModel/Random"</Output>
    </GraphCell>
    <GraphCell style="Graph" closed="false">
      <Input>loadModel(Modelica)
</Input>
      <Output>true</Output>
    </GraphCell>
    <GraphCell style="Graph" closed="false">
      <Input>loadFile("MathRandom.mo")</Input>
      <Output>true</Output>
    </GraphCell>
    <GraphCell style="Graph" closed="false">
      <Input>simulate(test_MR)</Input>
      <Output>record SimulationResult
    resultFile = "test_MR_res.mat",
    messages = ""
end SimulationResult;</Output>
    </GraphCell>
    <GraphCell style="Graph" closed="false">
      <Input>s1:=1.0;
s2:=2.0;
s3:=3.0;
x:=0.0;</Input>
      <Output>[done]</Output>
    </GraphCell>
    <GraphCell style="Graph" closed="false">
      <Input>(x,s1,s2,s3):=MR(s1,s2,s3,0.0);
x</Input>
      <Output>0.8655107863136287</Output>
    </GraphCell>
    <GraphCell style="Graph" closed="false">
      <Input>simulate(test_MR, stopTime=1.0)</Input>
      <Output>record SimulationResult
    resultFile = "test_MR_res.mat",
    messages = ""
end SimulationResult;</Output>
    </GraphCell>
    <GraphCell style="Graph" closed="false">
      <OMCPlot PlotType="0" XRangeMin="0" Title="Plot by OpenModelica" LogX="false" XRangeMax="0" Grid="true" LogY="false" YRangeMin="0" YRangeMax="0" YLabel="" Legend="true" XLabel="time">
        <Curve Title="y" Visible="true" XData="" YData="" Color="4294901760"/>
      </OMCPlot>
      <Input>plot(y)</Input>
      <Output>[done]</Output>
    </GraphCell>
  </GroupCell>
</Notebook>
