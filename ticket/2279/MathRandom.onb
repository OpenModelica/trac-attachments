<!DOCTYPE OMNotebook>
<Notebook>
  <GroupCell closed="false">
    <GraphCell style="Graph" closed="false">
      <Input>getVersion();
cd()</Input>
      <Output>"1.9.0 beta4+dev (r16572)"
"C:/Users/Lennart/AppData/Local/Temp/OpenModelica"</Output>
    </GraphCell>
    <GraphCell style="Graph" closed="false">
      <Input>clear();
list()</Input>
      <Output>true
""</Output>
    </GraphCell>
    <GraphCell style="Graph" closed="false">
      <Input>function MathRandom
  input Real s1, s2, s3;
  input Real tim;
  output Real x;
  output Real a, b, c;

algorithm
  a := mod(tim-11, tim+13);
  a := exp(a);
  a := rem(171*s1*a, 30269.0);
  a := abs(a);
   
  b := mod(tim-5, tim+7); 
  b := exp(b);
  b := rem(172*s2*b, 30307.0);
  b := abs(b);
  
  c := mod(tim-23, tim+76);
  c := exp(c);
  c := rem(170*s3*c, 30323.0);  
  c := abs(c);
  
  // hack
  // if c > 30323.0 then
  //   c := 1.0;
  // end if;
  
  if a &lt; 1e-4 then
    a := 1.0;
  end if;
  if b &lt; 1e-4 then
    b := 1.0;
  end if;
  if c &lt; 1e-4 then
    c := 1.0;
  end if;
  x := rem((a/30269.0+b/30307.0+c/30323.0), 1.0);
end MathRandom;

model test_MR
  output Real y(start=0.0);
  parameter Real dtSample = 0.1;

protected
  Real s1(start=1.0);
  Real s2(start=2.0);
  Real s3(start=3.0);
  
algorithm
  when sample(0.0, dtSample) then
    (y, s1, s2, s3) := MathRandom(s1, s2, s3, time/10.0);
  end when;
end test_MR;</Input>
      <Output>{MathRandom,test_MR}</Output>
    </GraphCell>
    <GraphCell style="Graph" closed="false">
      <Input>s1 := 1.0;
s2 := 2.0;
s3 := 3.0;
x := 0.0;</Input>
      <Output>[done]</Output>
    </GraphCell>
    <GraphCell style="Graph" closed="false">
      <Input>(x, s1, s2, s3) := MathRandom(s1, s2, s3, 0.0);
x</Input>
      <Output>0.12564587750377865</Output>
    </GraphCell>
    <GraphCell style="Graph" closed="false">
      <Input>setCommandLineOptions({"+d=initialization"});
simulate(test_MR)</Input>
      <Output>{true}
record SimulationResult
    resultFile = "test_MR_res.mat",
    messages = ""
end SimulationResult;
OMC-ERROR: 
"Warning: Assuming fixed start value for the following 4 variables:
         s3:DISCRETE(start = 3.0 fixed = false protected = true ) .test_MR, .Real type: Real 
         s2:DISCRETE(start = 2.0 fixed = false protected = true ) .test_MR, .Real type: Real 
         s1:DISCRETE(start = 1.0 fixed = false protected = true ) .test_MR, .Real type: Real 
         y:DISCRETE(start = 0.0 fixed = false ) .test_MR, .Real type: Real 
"</Output>
    </GraphCell>
    <GraphCell style="Graph" closed="false">
