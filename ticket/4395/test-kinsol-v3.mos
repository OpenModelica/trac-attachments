loadString("
model Test
  parameter Integer N = 20;
  parameter Real k_min = 1;
  parameter Real k_max = 2;
  parameter Real d_0_a = 0.1;
  parameter Real d_0_b = 1;
  parameter Real d_tot = 1;
  final parameter Real s_0_a = d_0_a/N;
  final parameter Real s_0_b = d_0_b/N;
  Real d[N+1];
  Real s[N];
  Real F_a[N];
  Real F_b[N];
  Real k[N];
equation
  d[1] = 0;
  for i in 1:N loop
    d[i+1] = d[i] + s[i]; 
    s[i]*(1 + abs(s[i])/s_0_a)*k[i]*N = F_a[i];
    s[i]*(1 + abs(s[i])/s_0_b)*k[i]*N = F_b[i];
    k[i] = k_min + (k_max-k_min)/(N-1)*(i-1);
  end for;
  for i in 1:N-1 loop
    F_a[i] + F_b[i] = F_a[i+1] + F_b[i+1];
  end for;
  d[end] = d_tot;
end Test;
");getErrorString();

setCommandLineOptions("--maxSizeNonlinearTearing=0");getErrorString();
setCommandLineOptions("--preOptModules-=removeSimpleEquations");getErrorString();
setCommandLineOptions("--postOptModules-=removeSimpleEquations");getErrorString();
setCommandLineOptions("--maxSizeNonlinearTearing=0");getErrorString();

//loadString("model Test2 extends Test(N=10); end Test2;"); simulate(Test2, numberOfIntervals = 1, simflags="-lv=LOG_NLS_V -nls=kinsol -s=euler");getErrorString();
