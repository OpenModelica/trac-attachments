// Test 4: N=100, d_0 = 10000 (almost linear problem),  first doesn't converge quickly enough, second converges quickly. Very similar to RETE_C initialization
//loadString("model Test4 extends Test(N=100, d_0 = 10000); end Test4;"); simulate(Test4, numberOfIntervals = 1, simflags="-lv=LOG_NLS_V -nls=kinsol -s=euler");getErrorString();

// Test 5: N=100, d_0 = 1e7 (practically linear problem),  first doesn't converge quickly enough, second converges quickly. Very similar to RETE_C initialization
//loadString("model Test5 extends Test(N=100, d_0 = 1e7); end Test5;"); simulate(Test5, numberOfIntervals = 1, simflags="-lv=LOG_NLS_V -nls=kinsol -s=euler");getErrorString();

// Test 6: N=100, k_min = 1e8, k_max = 2e8 (badly scaled), first four attempts do not converge, the fift finally does
//loadString("model Test6 extends Test(N=100, k_min = 1e8, k_max = 2e8); end Test6;"); simulate(Test6, numberOfIntervals = 1, simflags="-lv=LOG_NLS_V -nls=kinsol -s=euler");getErrorString();

// Test 8: N=50, k_min = 1, k_max = 2. Inherently well-scaled
loadString("model Test8 extends Test(N=50, k_min = 1, k_max = 2); end Test8;"); simulate(Test8, numberOfIntervals = 1, simflags="-lv=LOG_NLS_V -nls=kinsol -s=euler");getErrorString();

// Test 9: N=50, k_min = 1e8, k_max = 2e8. Badly scaled, but with nominal values on badly scaled unknowns
loadString("model Test9 extends Test(N=50, k_min = 1e8, k_max = 2e8, F(each nominal=1e8), k(each nominal = 1e8)); end Test9;"); simulate(Test9, numberOfIntervals = 1, simflags="-lv=LOG_NLS_V -nls=kinsol -s=euler");getErrorString();

