<!DOCTYPE OMNotebook>
<Notebook>
 <GroupCell closed="false" >
  <InputCell style="Input" closed="false" >
   <Input>loadModel(Modelica);
loadFile("c:/modelicaprj/packages/control.mo");</Input>
   <Output>[done]</Output>
  </InputCell>
  <InputCell style="Input" closed="false" >
   <Input>model prueba
  Control.Sources.DiscreteSpeedTrapezium trapezium(acc1=1,acc2=1,dec1=1,dec2=1,pv_acc=0.5,pv_dec=0.5,adv=4,vel=1,period=0.5);
end prueba;</Input>
   <Output>Ok</Output>
  </InputCell>
  <InputCell style="Input" closed="false" >
   <Input>simulate(prueba,stopTime=5.0)</Input>
   <Output>record
    resultFile = "prueba_res.plt"
end record</Output>
  </InputCell>
  <InputCell style="Input" closed="false" >
   <Input>plot({trapezium.counter})</Input>
   <Output>&lt;html>&lt;head>&lt;meta name="qrichtext" content="1" />&lt;/head>&lt;body style=" white-space: pre-wrap; font-family:MS Shell Dlg; font-size:8.25pt; font-weight:400; font-style:normal; text-decoration:none;">&lt;p style=" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; font-family:Courier New; font-size:11pt; color:#000000;">&lt;img src="file:///C:/OpenModelica1.4.3/bin/OMNoteboook_tempfiles/15.png" width="492" height="250" />&lt;/p>&lt;/body>&lt;/html></Output>
   <Image name="file:///C:/OpenModelica1.4.3/bin/OMNoteboook_tempfiles/15.png" ></Image>
  </InputCell>
 </GroupCell>
</Notebook>
