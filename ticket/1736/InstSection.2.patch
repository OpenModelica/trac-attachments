   end matchcontinue;
 end cevalIfConstant;
 
+public function cevalListIfConstantOrParam
+  "This function constant evaluates an expression if the expression is constant,
+   or if the expression is a call of parameter constness whose return type
+   contains unknown dimensions (in which case we need to determine the size of
+   those dimensions)."
+  input Env.Cache inCache;
+  input Env.Env inEnv;
+  input list<DAE.Exp> inExps;
+  input list<DAE.Const> inConst;
+  input Boolean impl;
+  input Msg msg;
+  input list<DAE.Exp> acc;
+  output Env.Cache outCache;
+  output list<DAE.Exp> outExps;
+algorithm
+  (outCache, outExps) := match (inCache, inEnv, inExps, inConst, impl, msg, acc)
+    local
+      list<DAE.Exp> exps;
+      DAE.Exp exp;
+      DAE.Const const;
+      list<DAE.Const> consts;
+      Env.Cache cache;
+      Env.Env env;
+      Values.Value val;
+    case (cache,env,exp::exps,DAE.C_VAR()::consts,impl,msg,acc)
+      equation
+        (cache,exps) = cevalListIfConstantOrParam(cache, env, exps, consts, impl, msg, exp::acc);
+      then (cache,exps);
+    case (cache,env,exp::exps,_::consts,impl,msg,acc)
+      equation
+        (cache,val,_) = ceval(cache, env, exp, impl, NONE(), msg);
+        exp = ValuesUtil.valueExp(val);
+        (cache,exps) = cevalListIfConstantOrParam(cache, env, exps, consts, impl, msg, exp::acc);
+      then (cache,exps);
+    case (cache,_,{},{},_,_,acc) then (cache,listReverse(acc));
+  end match;
+end cevalListIfConstantOrParam;
+
 protected function cevalWholedimRetCall
   "Helper function to cevalIfConstant. Determines the size of any unknown
    dimensions in a function calls return type."
