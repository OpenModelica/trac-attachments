+protected function replaceConnectWithLegalEquation
+  "Replaces connections with a legal terminate equation"
+  input tuple<SCode.EEquation, Boolean> inTuple;
+  output tuple<SCode.EEquation, Boolean> outTuple;
+algorithm
+  outTuple := match inTuple
+    local
+      Absyn.Info info;
+    case ((SCode.EQ_CONNECT(info=info),true))
+      then ((SCode.EQ_TERMINATE(Absyn.STRING("Connection removed from type checking since branch was false"),NONE(),info),true));
+    else inTuple;
+  end match;
+end replaceConnectWithLegalEquation;
+
+protected function findConnectInNonParamIfError
+  "Replaces connections with a legal terminate equation"
+  input tuple<SCode.EEquation, Integer> inTuple;
+  output tuple<SCode.EEquation, Integer> outTuple;
+algorithm
+  outTuple := match inTuple
+    local
+      Absyn.Info info;
+    case ((SCode.EQ_CONNECT(info=info),_))
+      equation
+        Error.addSourceMessage(Error.INTERNAL_ERROR,{"Connections are not allowed in if-branches that cannot be evaluated at runtime"},info);
+      then fail();
+    else inTuple;
+  end match;
+end findConnectInNonParamIfError;
+
+protected function makeIfEquation "Selects branches and creates the elements associated with the if-equation"
+  input Env.Cache inCache;
+  input Env.Env inEnv;
+  input Boolean impl;
+  input InstanceHierarchy ih;
+  input Prefix.Prefix pre;
+  input Boolean isInitial;
+  input list<DAE.Exp> exps;
+  input list<list<DAE.Element>> tbs;
+  input list<DAE.Element> fb;
+  input list<DAE.Exp> accExp;
+  input list<list<DAE.Element>> accTb;
+  input DAE.ElementSource source;
+  output Env.Cache outCache;
+  output DAE.DAElist dae;
+algorithm
+  (outCache,dae) := matchcontinue (inCache,inEnv,impl,ih,pre,isInitial,exps,tbs,fb,accExp,accTb,source)
+    local
+      DAE.Exp exp;
+      list<DAE.Element> tb,elts;
+      list<list<DAE.Element>> restTb;
+      list<DAE.Exp> restExp,exps;
+      list<DAE.Properties> restProp;
+      DAE.Properties prop;
+      Env.Cache cache;
+      Boolean b;
+      Option<Values.Value> containsEmpty;
+      DAE.Const cnst;
+      list<Values.Value> valList;
+      list<Boolean> blist;
+    case (cache,inEnv,impl,ih,pre,isInitial,DAE.BCONST(false)::restExp,_::restTb,fb,accExp,accTb,source)
+      equation
+        (cache,dae) = makeIfEquation(cache,inEnv,impl,ih,pre,isInitial,restExp,restTb,fb,accExp,accTb,source);
+      then (cache,dae);
+    case (cache,inEnv,impl,ih,pre,isInitial,DAE.BCONST(true)::restExp,tb::_,_,accExp,accTb,source)
+      equation
+        elts = makeIfEquation2(isInitial,listReverse(accExp),listReverse(accTb),tb,source);
+      then (cache,DAE.DAE(elts));
+    case (cache,inEnv,impl,ih,pre,isInitial,exp::restExp,tb::restTb,fb,accExp,accTb,source)
+      equation
+        (cache,dae) = makeIfEquation(cache,inEnv,impl,ih,pre,isInitial,restExp,restTb,fb,exp::accExp,tb::accTb,source);
+      then (cache,dae);
+    case (cache,inEnv,impl,ih,pre,isInitial,{},{},fb,accExp,accTb,source)
+      equation
+        elts = makeIfEquation2(isInitial,listReverse(accExp),listReverse(accTb),fb,source);
+      then (cache,DAE.DAE(elts));
+  end matchcontinue;
+end makeIfEquation;
+
+protected function makeIfEquation2
+  input Boolean isInitial;
+  input list<DAE.Exp> exps;
+  input list<list<DAE.Element>> tbs;
+  input list<DAE.Element> fb;
+  input DAE.ElementSource source;
+  output list<DAE.Element> outElements;
+algorithm
+  outElements := matchcontinue (isInitial,exps,tbs,fb,source)
+    case (_,{},_,fb,source)
+      then fb;
+    case (false,exps,tbs,fb,source)
+      then DAE.IF_EQUATION(exps,tbs,fb,source)::{};
+    case (true,exps,tbs,fb,source)
+      then DAE.INITIAL_IF_EQUATION(exps,tbs,fb,source)::{};
+  end matchcontinue;
+end makeIfEquation2;
