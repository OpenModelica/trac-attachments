+public function isFalse
+"function: isFalse
+  Returns true if an expression is constant
+  and has the value false, otherwise false"
+  input DAE.Exp inExp;
+  output Boolean outBoolean;
+algorithm
+  outBoolean := match (inExp)
+    local
+      Boolean b;
+    case (DAE.BCONST(b)) then not b;
+    else false;
+  end match;
+end isFalse;
+
+public function isTrue
+"function: isTrue
+  Returns true if an expression is constant
+  and has the value false, otherwise false"
+  input DAE.Exp inExp;
+  output Boolean outBoolean;
+algorithm
+  outBoolean := match (inExp)
+    local
+      Boolean b;
+    case (DAE.BCONST(b)) then b;
+    else false;
+  end match;
+end isTrue;
