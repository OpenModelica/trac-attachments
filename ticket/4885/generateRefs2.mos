loadModel(Modelica);
deleteFile("exec.mos");
Modelica.Utilities.Streams.print("loadModel(Modelica);getErrorString();","exec.mos");
Modelica.Utilities.Streams.print("loadFile(\"../ScalableTestSuite/ScalableTestSuite/package.mo\");getErrorString();","exec.mos");
Modelica.Utilities.Streams.print("setCFlags(getCFlags()+\" -O0\"); getErrorString();","exec.mos");
Modelica.Utilities.Streams.print("setCommandLineOptions(\"-d=nogen,initialization --maxSizeLinearTearing=0\");","exec.mos");
Modelica.Utilities.Streams.print("simflags:=\"-mei=4000 -s=ida -idaLS=klu -ls=klu -nls=kinsol\";","exec.mos");
Modelica.Utilities.Streams.print("cleancmd:=\"rm *.o *.c *.h *.log *.libs *.makefile *.json *.xml\";","exec.mos");
Modelica.Utilities.Streams.print("mvcmd:=\"mv Sca*.mat Results\";","exec.mos");
Modelica.Utilities.Streams.print("","exec.mos");

