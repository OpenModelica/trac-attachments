k :=size(testCases,1);
for i in 1:k loop
  str1 := "simulate(";
  str2 := testCases[i,2];
  str3 := ", simflags=simflags, variableFilter=\"";
  str3 := ", fileNamePrefix = \"output\", simflags=simflags, variableFilter=\"";
  str4 := testCases[i,3];
  str5 := "\");getErrorString();";
  str6 := "vars := readSimulationResultVars(\"output_res.mat\"";
  if testCases[i,1] == "V" 
    then str7 := ",readParameters=false";
    else str7 := "";
  end if;
  str8 := ");getErrorString();filterSimulationResults(\"output_res.mat\",\"";
  str9 := testCases[i,2];
  str10 := "_res.mat\", vars, removeDescription = false);getErrorString();";
  str11 := "system(cleancmd);getErrorString();system(mvcmd);getErrorString();";
  str:= str1 + str2 + str3 + str4 + str5 + str6 + str7 +  str8 + str9 + str10 + str11;
  Modelica.Utilities.Streams.print(str,"exec.mos");
end for;

system("omc exec.mos");getErrorString();
