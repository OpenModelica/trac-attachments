loadString("
model UnfixedParameter
    parameter Real c(fixed = false);
    Real x(start=c,fixed=true);
initial equation 
    c = 1;
equation 
    der(x) = -x;
end UnfixedParameter;
"); getErrorString();

simulate(UnfixedParameter, startTime=0.0, stopTime=1.0, numberOfIntervals=0); getErrorString();
res := OpenModelica.Scripting.readSimulationResult("UnfixedParameter_res.mat", {time, x}, 3); getErrorString();
