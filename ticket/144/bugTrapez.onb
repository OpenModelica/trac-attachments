<!DOCTYPE OMNotebook>
<Notebook>
 <GroupCell closed="false" >
  <InputCell style="Input" closed="false" >
   <Input>loadModel( Modelica );</Input>
   <Output>[done]</Output>
  </InputCell>
  <InputCell style="Input" closed="false" >
   <Input>model bugTrapez
  Modelica.Blocks.Sources.Trapezoid trap1( startTime=0.1, rising=0.45);
  Modelica.Blocks.Sources.Trapezoid trap2( startTime=0.5, rising=0.5);
end bugTrapez;</Input>
   <Output>Ok</Output>
  </InputCell>
  <InputCell style="Input" closed="false" >
   <Input>simulate( bugTrapez )</Input>
   <Output>record
    resultFile = "bugTrapez_res.plt"
end record</Output>
  </InputCell>
  <InputCell style="Input" closed="false" >
   <Input>plot( {trap1.y, trap2.y} )</Input>
   <Output>&lt;html>&lt;head>&lt;meta name="qrichtext" content="1" />&lt;style type="text/css">
p, li { white-space: pre-wrap; }
&lt;/style>&lt;/head>&lt;body style=" font-family:'MS Shell Dlg 2'; font-size:8.25pt; font-weight:400; font-style:normal;">
&lt;table style="-qt-table-type: root; margin-top:5px; margin-bottom:5px; margin-left:5px; margin-right:5px;">
&lt;tr>
&lt;td style="border: none;">
&lt;p style=" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; font-size:8pt;">&lt;img src="file:///C:/Tvorenie/Modelica/PokusneModely/OMNoteboook_tempfiles/5.png" width="492" height="243" />&lt;/p>&lt;/td>&lt;/tr>&lt;/table>&lt;/body>&lt;/html></Output>
   <Image name="file:///C:/Tvorenie/Modelica/PokusneModely/OMNoteboook_tempfiles/5.png" ></Image>
  </InputCell>
  <TextCell style="Section (no numbers)" >
   <Text>&lt;html>&lt;head>&lt;meta name="qrichtext" content="1" />&lt;style type="text/css">
p, li { white-space: pre-wrap; }
&lt;/style>&lt;/head>&lt;body style=" font-family:'MS Shell Dlg 2'; font-size:8.25pt; font-weight:400; font-style:normal;">
&lt;table border="0" style="-qt-table-type: root; margin-top:5px; margin-bottom:5px; margin-left:5px; margin-right:5px;">
&lt;tr>
&lt;td style="border: none;">
&lt;p style="-qt-paragraph-type:empty; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; font-size:8pt;">&lt;/p>
&lt;p style="-qt-paragraph-type:empty; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; font-size:8pt;">&lt;/p>
&lt;p style="-qt-paragraph-type:empty; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; font-size:8pt;">&lt;/p>
&lt;p style="-qt-paragraph-type:empty; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; font-family:'Times'; font-size:18pt; font-weight:600; color:#000000;">&lt;/p>
&lt;p style=" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; font-family:'Times'; font-size:18pt; font-weight:600; color:#000000;">&lt;span style=" color:#ff0000;">Only trap1.rising is set to 0.5 to not reset the rising start of trap2.y&lt;/span>&lt;/p>&lt;/td>&lt;/tr>&lt;/table>&lt;/body>&lt;/html></Text>
  </TextCell>
  <InputCell style="Input" closed="false" >
   <Input>model okTrapez
  Modelica.Blocks.Sources.Trapezoid trap1( startTime=0.1, rising=0.5);
  Modelica.Blocks.Sources.Trapezoid trap2( startTime=0.5, rising=0.5);
end okTrapez;</Input>
   <Output>Ok</Output>
  </InputCell>
  <InputCell style="Input" closed="false" >
   <Input>simulate( okTrapez )</Input>
   <Output>record
    resultFile = "okTrapez_res.plt"
end record</Output>
  </InputCell>
  <InputCell style="Input" closed="false" >
   <Input>plot( {trap1.y, trap2.y} )</Input>
   <Output>&lt;html>&lt;head>&lt;meta name="qrichtext" content="1" />&lt;style type="text/css">
p, li { white-space: pre-wrap; }
&lt;/style>&lt;/head>&lt;body style=" font-family:'MS Shell Dlg 2'; font-size:8.25pt; font-weight:400; font-style:normal;">
&lt;table style="-qt-table-type: root; margin-top:5px; margin-bottom:5px; margin-left:5px; margin-right:5px;">
&lt;tr>
&lt;td style="border: none;">
&lt;p style=" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; font-size:8pt;">&lt;img src="file:///C:/Tvorenie/Modelica/PokusneModely/OMNoteboook_tempfiles/6.png" width="492" height="243" />&lt;/p>&lt;/td>&lt;/tr>&lt;/table>&lt;/body>&lt;/html></Output>
   <Image name="file:///C:/Tvorenie/Modelica/PokusneModely/OMNoteboook_tempfiles/6.png" ></Image>
  </InputCell>
 </GroupCell>
</Notebook>
