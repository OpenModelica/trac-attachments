loadString("
model Test
  parameter Integer N = 20;
  parameter Real k_min = 1;
  parameter Real k_max = 2;
  parameter Real d_0_a = 0.1;
  parameter Real d_0_b = 1;
  parameter Real m = 1;
  final parameter Real s_0_a = d_0_a/N;
  final parameter Real s_0_b = d_0_b/N;
  Real d_tot(start = 0, fixed = true);
  Real v(start = 1, fixed = true);
  Real d[N+1];
  Real s[N];
  Real F_a[N];
  Real F_b[N];
  Real k[N];
  Real F;
equation
  d[1] = 0;
  for i in 1:N loop
    d[i+1] = d[i] + s[i]; 
    s[i]*(1 + abs(s[i])/s_0_a)*k[i]*N = F_a[i];
    s[i]*(1 + abs(s[i])/s_0_b)*k[i]*N = F_b[i];
    k[i] = k_min + (k_max-k_min)/(N-1)*(i-1);
  end for;
  for i in 1:N-1 loop
    F_a[i] + F_b[i] = F_a[i+1] + F_b[i+1];
  end for;
  d[end] = d_tot;
  F_a[end] + F_b[end] + F = 0;
  der(d_tot) = v;
  m*der(v) = F;
end Test;
");getErrorString();

setCommandLineOptions("--maxSizeNonlinearTearing=0 --daeMode=all");getErrorString();

// Test 1 well-scaled model
//loadString("model Test1 extends Test(N=1000); end Test1;"); simulate(Test1, stopTime = 4, simflags="-lv=LOG_STATS -nls=kinsol -daeMode -s=ida -idaLS=klu -noEquidistantTimeGrid");getErrorString();

// Test 2 badly scaled model
//loadString("model Test2 extends Test(N=1000,k_min = 1e9, k_max = 2e9, m = 1e9); end Test2;");  simulate(Test2, stopTime = 4, simflags="-lv=LOG_STATS -nls=kinsol -daeMode -s=ida -idaLS=klu -noEquidistantTimeGrid");getErrorString();

// Test 3 badly scaled model with nominal attributes
loadString("model Test3 extends Test(N=1000,k_min = 1e9, k_max = 2e9, m = 1e9, F_a(each nominal=1e9), F_b(each nominal=1e9), F(each nominal = 1e9),k(each nominal = 1e9)); end Test3;"); simulate(Test3, stopTime = 4, simflags="-lv=LOG_STATS -nls=kinsol -daeMode -s=ida -idaLS=klu -noEquidistantTimeGrid");getErrorString();
