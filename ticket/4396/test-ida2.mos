loadString("
model Test
  parameter Integer N = 20;
  parameter Real k_min = 1;
  parameter Real k_max = 2;
  parameter Real d_0 = 10;
  Real d_tot(start = 0, fixed = true);
  final parameter Real s_0 = d_0/N;
  Real d[N+1];
  Real s[N];
  Real F[N];
  Real k[N];
equation
  der(d_tot) = 1;
  d[1] = 0;
  for i in 1:N loop
    d[i+1] = d[i] + s[i]; 
    s[i]*(1 + abs(s[i])/s_0)*k[i]*N = F[i];
    k[i] = k_min + (k_max-k_min)/(N-1)*(i-1);
  end for;
  for i in 1:N-1 loop
    F[i] = F[i+1];
  end for;
  d[end] = d_tot;
end Test;
");getErrorString();

setCommandLineOptions("--maxSizeNonlinearTearing=0 --daeMode=all");getErrorString();

// Test 1 well-scaled model
//loadString("model Test1 extends Test(N=700); end Test1;");                                               simulate(Test1, stopTime = 2, simflags="-lv=LOG_STATS -nls=kinsol -daeMode -s=ida -idaLS=klu -noEquidistantTimeGrid");getErrorString();

// Test 2 badly scaled model
//loadString("model Test2 extends Test(N=700,k_min = 1e8, k_max = 2e8); end Test2;");                      simulate(Test2, stopTime = 2, simflags="-lv=LOG_STATS -nls=kinsol -daeMode -s=ida -idaLS=klu -noEquidistantTimeGrid");getErrorString();

