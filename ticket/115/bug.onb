<!DOCTYPE OMNotebook>
<Notebook>
 <GroupCell closed="false" >
  <InputCell style="Input" closed="false" >
   <Input>loadModel(Modelica);
loadFile("c:/modelicaprj/packages/control.mo");</Input>
   <Output>[done]</Output>
  </InputCell>
  <InputCell style="Input" closed="false" >
   <Input>model pr
  Control.Sources.SpeedTrapezium trap(acc1=1,acc2=2,dec1=1,dec2=2,pv_acc=0.2,pv_dec=0.8,adv=4,vel=2);
  Modelica.Blocks.Discrete.Sampler sampler;
equation
  connect(trap.y,sampler.u);
end pr;</Input>
   <Output>Ok</Output>
  </InputCell>
  <InputCell style="Input" closed="false" >
   <Input>simulate(pr,stopTime=10)</Input>
   <Output>record
    resultFile = "pr_res.plt"
end record</Output>
  </InputCell>
  <InputCell style="Input" closed="false" >
   <Input>plot({trap.y,sampler.y})</Input>
   <Output>&lt;html>&lt;head>&lt;meta name="qrichtext" content="1" />&lt;/head>&lt;body style=" white-space: pre-wrap; font-family:MS Shell Dlg; font-size:8.25pt; font-weight:400; font-style:normal; text-decoration:none;">&lt;p style=" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; font-family:Courier New; font-size:11pt; color:#000000;">&lt;img src="file:///C:/OpenModelica1.4.3/bin/OMNoteboook_tempfiles/21.png" width="492" height="250" />&lt;/p>&lt;/body>&lt;/html></Output>
   <Image name="file:///C:/OpenModelica1.4.3/bin/OMNoteboook_tempfiles/21.png" ></Image>
  </InputCell>
  <InputCell style="Input" closed="false" >
   <Input>model pt
  Modelica.Blocks.Sources.Sine sine;
  Modelica.Blocks.Discrete.Sampler sampler;
equation
  connect(sine.y,sampler.u);
end pt;</Input>
   <Output>Ok</Output>
  </InputCell>
  <InputCell style="Input" closed="false" >
   <Input>simulate(pt,stopTime=10)</Input>
   <Output>record
    resultFile = "pt_res.plt"
end record</Output>
  </InputCell>
  <InputCell style="Input" closed="false" >
   <Input>plot({sine.y,sampler.y})</Input>
   <Output>&lt;html>&lt;head>&lt;meta name="qrichtext" content="1" />&lt;/head>&lt;body style=" white-space: pre-wrap; font-family:MS Shell Dlg; font-size:8.25pt; font-weight:400; font-style:normal; text-decoration:none;">&lt;p style=" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; font-family:Courier New; font-size:11pt; color:#000000;">&lt;img src="file:///C:/OpenModelica1.4.3/bin/OMNoteboook_tempfiles/22.png" width="492" height="250" />&lt;/p>&lt;/body>&lt;/html></Output>
   <Image name="file:///C:/OpenModelica1.4.3/bin/OMNoteboook_tempfiles/22.png" ></Image>
  </InputCell>
 </GroupCell>
</Notebook>
