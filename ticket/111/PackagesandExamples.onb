<!DOCTYPE OMNotebook>
<Notebook>
 <GroupCell closed="false" >
  <GroupCell closed="false" >
   <GroupCell closed="false" >
    <TextCell style="Text" >
     <Text>&lt;html>&lt;head>&lt;meta name="qrichtext" content="1" />&lt;/head>&lt;body style=" white-space: pre-wrap; font-family:MS Shell Dlg; font-size:8.25pt; font-weight:400; font-style:normal; text-decoration:none;">&lt;p style=" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; font-family:Times New Roman; font-size:12pt; color:#000000;">&lt;span style=" font-size:16pt; font-weight:600;">Packages and examples&lt;/span>&lt;/p>&lt;/body>&lt;/html></Text>
    </TextCell>
    <InputCell style="Input" closed="false" >
     <Input>loadModel(Modelica);
loadFile("c:/modelicaprj/packages/mediapath.mo");
loadFile("c:/modelicaprj/packages/control.mo");
loadFile("c:/modelicaprj/packages/other.mo");</Input>
     <Output>[done]</Output>
    </InputCell>
   </GroupCell>
   <GroupCell closed="false" >
    <TextCell style="Text" >
     <Text>&lt;html>&lt;head>&lt;meta name="qrichtext" content="1" />&lt;/head>&lt;body style=" white-space: pre-wrap; font-family:MS Shell Dlg; font-size:8.25pt; font-weight:400; font-style:normal; text-decoration:none;">&lt;p style=" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; font-family:Times New Roman; font-size:12pt; color:#000000;">&lt;span style=" font-weight:600;">MediaPath package&lt;/span>&lt;/p>&lt;/body>&lt;/html></Text>
    </TextCell>
    <TextCell style="Text" >
     <Text>&lt;html>&lt;head>&lt;meta name="qrichtext" content="1" />&lt;/head>&lt;body style=" white-space: pre-wrap; font-family:MS Shell Dlg; font-size:8.25pt; font-weight:400; font-style:normal; text-decoration:none;">&lt;p style=" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; font-family:Times New Roman; font-size:12pt; color:#000000;">This package contains models for the elements found at a printers media path. The elements currently included in the package are two kinds of roller, the drive roller and a paper roll, and a totally rigid paper, as well as their connectors.&lt;/p>&lt;/body>&lt;/html></Text>
    </TextCell>
    <InputCell style="Input" closed="false" >
     <Input>list(MediaPath)</Input>
     <Output>"package MediaPath
  package Interfaces
      connector PaperCut
          Modelica.SIunits.Position pos;
      flow Modelica.SIunits.Force F;
    end PaperCut;
    partial model Paper
          PaperCut cut_a,cut_b;
      Modelica.SIunits.Force F;
      Modelica.SIunits.Length pos_rel;

    equation 
      pos_rel=cut_a.pos - cut_b.pos;
      cut_a.F=F;
      cut_b.F=-F;
    end Paper;
    partial model Roller
          extends Modelica.Mechanics.Rotational.Interfaces.Rigid(phi(start=0));
      parameter Modelica.SIunits.Inertia J=1;
      parameter Modelica.SIunits.Radius r=1;
      Modelica.SIunits.AngularVelocity w(start=0);
      Modelica.SIunits.AngularAcceleration a;
      Modelica.SIunits.Position tanPos;
      Modelica.SIunits.Velocity tanVel;

    equation 
      w=der(phi);
      a=der(w);
      tanPos=phi*r;
      tanVel=w*r;
    end Roller;
  end Interfaces;
  model DriveRoller
      extends Interfaces.Roller;
    Interfaces.PaperCut cut_a,cut_b;

  equation 
    cut_a.pos=phi*r;
    cut_b.pos=phi*r;
    J*a=flange_a.tau + flange_b.tau + cut_a.F*r + cut_b.F*r;
  end DriveRoller;
  model PaperRoll
      extends Interfaces.Roller;
    Interfaces.PaperCut cut_b;

  equation 
    cut_b.pos=phi*r;
    J*a=flange_a.tau + flange_b.tau + cut_b.F*r;
  end PaperRoll;
  model Cardboard
      extends Interfaces.Paper;

  equation 
    pos_rel=0;
  end Cardboard;
  model RealPaper
      extends Interfaces.Paper;
    parameter Real k=1;

  equation 
    F=if pos_rel > 0 then 0 else pos_rel*k;
  end RealPaper;
end MediaPath;

"</Output>
    </InputCell>
   </GroupCell>
   <GroupCell closed="false" >
    <TextCell style="Text" >
     <Text>&lt;html>&lt;head>&lt;meta name="qrichtext" content="1" />&lt;/head>&lt;body style=" white-space: pre-wrap; font-family:MS Shell Dlg; font-size:8.25pt; font-weight:400; font-style:normal; text-decoration:none;">&lt;p style=" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; font-family:Times New Roman; font-size:12pt; color:#000000;">&lt;span style=" font-weight:600;">Control package&lt;/span>&lt;/p>&lt;/body>&lt;/html></Text>
    </TextCell>
    <TextCell style="Text" >
     <Text>&lt;html>&lt;head>&lt;meta name="qrichtext" content="1" />&lt;/head>&lt;body style=" white-space: pre-wrap; font-family:MS Shell Dlg; font-size:8.25pt; font-weight:400; font-style:normal; text-decoration:none;">&lt;p style=" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; font-family:Times New Roman; font-size:12pt; color:#000000;">This package contains models for some control elements. It includes a discrete PID implementation that acts like that of GoldenGate media advance servo, a PWMGenerator that converts a signal to voltage and an assembly of a whole control loop.&lt;/p>&lt;/body>&lt;/html></Text>
    </TextCell>
    <InputCell style="Input" closed="false" >
     <Input>list(Control)</Input>
     <Output>"package Control
  block PID
      extends Modelica.Blocks.Interfaces.SISO;
    parameter Real Kp=1,Kd=1;
    Modelica.Blocks.Math.Gain proportional(k=Kp),derivative(k=Kd);
    Modelica.Blocks.Continuous.Der derivator;
    Modelica.Blocks.Math.Add sum;

  equation 
    connect(u,derivator.u);
    connect(u,proportional.u);
    connect(derivator.y,derivative.u);
    connect(proportional.y,sum.u1);
    connect(derivative.y,sum.u2);
    connect(sum.y,y);
  end PID;
  block DiscretePID
      extends Modelica.Blocks.Interfaces.DiscreteSISO;
    parameter Real Kp=1,Kd=1;
    Real verr;

  equation 
    verr=der(u);
    when {sampleTrigger,initial()} then
          y=(Kp*u + Kd*verr)/128;
    
    end when;
  end DiscretePID;
  model PWMGenerator
      Modelica.Blocks.Interfaces.RealInput u;
    Modelica.Electrical.Analog.Interfaces.Pin p,n;
    parameter Real gain=1;

  equation 
    p.v - n.v=u*gain;
    p.i + n.i=0;
  end PWMGenerator;
  model PWMSaturation
      Modelica.Blocks.Interfaces.RealInput u;
    Modelica.Electrical.Analog.Interfaces.Pin p,n;
    parameter Real gain=1;
    parameter Real saturation=42;

  equation 
    p.v - n.v=if u*gain > saturation then saturation else if u*gain &lt; -saturation then -saturation else u*gain;
    p.i + n.i=0;
  end PWMSaturation;
  model LowPassFilter
      parameter Real T=1;
    Modelica.Blocks.Interfaces.RealInput u;
    Modelica.Blocks.Interfaces.RealOutput y;

  equation 
    T*der(y) + y=u;
  end LowPassFilter;
  model Servo
      parameter Real KP=1800,KD=6000;
    parameter Real MotorJ=0.0001,MotorTorqueK=0.078,MotorResistance=7.1,MotorInductance=0.1;
    Modelica.Mechanics.Rotational.Interfaces.Flange_b flange_b;
    Modelica.Blocks.Interfaces.RealInput u;
    Modelica.Blocks.Math.Add comparator(k2=-1);
    PID pid(Kp=KP,Kd=KD);
    PWMSaturation pwm;
    Modelica.Electrical.Analog.Basic.Ground ground;
    DCMotor motor(load.J=MotorJ,emf1.k=MotorTorqueK,r1.R=MotorResistance,i1.L=MotorInductance);
    Modelica.Mechanics.Rotational.Sensors.AngleSensor encoder;

  equation 
    connect(u,comparator.u1);
    connect(comparator.y,pid.u);
    connect(pid.y,pwm.u);
    connect(pwm.p,motor.p);
    connect(pwm.n,motor.n);
    connect(motor.n,ground.p);
    connect(motor.flange_b,encoder.flange_a);
    connect(encoder.phi,comparator.u2);
    connect(motor.flange_b,flange_b);
  end Servo;
  model ServoWithIdealGear
      parameter Real KP=1800,KD=6000;
    parameter Real MotorJ=0.0001,MotorTorqueK=0.078,MotorResistance=7.1,MotorInductance=0.1;
    parameter Real GearRatio=40;
    Modelica.Mechanics.Rotational.Interfaces.Flange_b flange_b;
    Modelica.Blocks.Interfaces.RealInput u;
    Modelica.Blocks.Math.Add comparator(k2=-1);
    PID pid(Kp=KP,Kd=KD);
    PWMSaturation pwm;
    Modelica.Electrical.Analog.Basic.Ground ground;
    DCMotor motor(load.J=MotorJ,emf1.k=MotorTorqueK,r1.R=MotorResistance,i1.L=MotorInductance);
    Modelica.Mechanics.Rotational.IdealGear gear(ratio=GearRatio);
    Modelica.Mechanics.Rotational.Sensors.AngleSensor encoder;

  equation 
    connect(u,comparator.u1);
    connect(comparator.y,pid.u);
    connect(pid.y,pwm.u);
    connect(pwm.p,motor.p);
    connect(pwm.n,motor.n);
    connect(motor.n,ground.p);
    connect(motor.flange_b,gear.flange_a);
    connect(gear.flange_b,encoder.flange_a);
    connect(encoder.phi,comparator.u2);
    connect(gear.flange_b,flange_b);
  end ServoWithIdealGear;
  model ServoWithGear
      parameter Real KP=1800,KD=6000;
    parameter Real MotorJ=0.0001,MotorTorqueK=0.078,MotorResistance=7.1,MotorInductance=0.1;
    parameter Real GearRatio=40;
    parameter Real BacklashAmplitude=0.01,BacklashDamping=10;
    Modelica.Mechanics.Rotational.Interfaces.Flange_b flange_b;
    Modelica.Blocks.Interfaces.RealInput u;
    Modelica.Blocks.Math.Add comparator(k2=-1);
    PID pid(Kp=KP,Kd=KD);
    PWMSaturation pwm;
    Modelica.Electrical.Analog.Basic.Ground ground;
    DCMotor motor(load.J=MotorJ,emf1.k=MotorTorqueK,r1.R=MotorResistance,i1.L=MotorInductance);
    Modelica.Mechanics.Rotational.IdealGear gear(ratio=GearRatio);
    Modelica.Mechanics.Rotational.ElastoBacklash backlash(b=BacklashAmplitude,d=BacklashDamping);
    Modelica.Mechanics.Rotational.Sensors.AngleSensor encoder;

  equation 
    connect(u,comparator.u1);
    connect(comparator.y,pid.u);
    connect(pid.y,pwm.u);
    connect(pwm.p,motor.p);
    connect(pwm.n,motor.n);
    connect(motor.n,ground.p);
    connect(motor.flange_b,gear.flange_a);
    connect(gear.flange_b,backlash.flange_a);
    connect(backlash.flange_b,encoder.flange_a);
    connect(encoder.phi,comparator.u2);
    connect(backlash.flange_b,flange_b);
  end ServoWithGear;
  model DiscreteServoWithGear
      parameter Real KP=1800,KD=6000;
    parameter Real MotorJ=0.0001,MotorTorqueK=0.078,MotorResistance=7.1,MotorInductance=0.1;
    parameter Real GearRatio=40;
    parameter Real BacklashAmplitude=0.01,BacklashDamping=10;
    parameter Real SamplerPeriod=0.0012;
    Modelica.Mechanics.Rotational.Interfaces.Flange_b flange_b;
    Modelica.Blocks.Interfaces.RealInput u;
    Modelica.Blocks.Math.Add comparator(k2=-1);
    DiscretePID pid(Kp=KP,Kd=KD,samplePeriod=SamplerPeriod);
    PWMSaturation pwm;
    Modelica.Electrical.Analog.Basic.Ground ground;
    DCMotor motor(load.J=MotorJ,emf1.k=MotorTorqueK,r1.R=MotorResistance,i1.L=MotorInductance);
    Modelica.Mechanics.Rotational.IdealGear gear(ratio=GearRatio);
    Modelica.Mechanics.Rotational.ElastoBacklash backlash(b=BacklashAmplitude,d=BacklashDamping);
    Modelica.Mechanics.Rotational.Sensors.AngleSensor encoder;

  equation 
    connect(u,comparator.u1);
    connect(comparator.y,pid.u);
    connect(pid.y,pwm.u);
    connect(pwm.p,motor.p);
    connect(pwm.n,motor.n);
    connect(motor.n,ground.p);
    connect(motor.flange_b,gear.flange_a);
    connect(gear.flange_b,backlash.flange_a);
    connect(backlash.flange_b,encoder.flange_a);
    connect(encoder.phi,comparator.u2);
    connect(backlash.flange_b,flange_b);
  end DiscreteServoWithGear;
  model ServoWithFilter
      parameter Real KP=1800,KD=6000;
    parameter Real MotorJ=0.0001,MotorTorqueK=0.078,MotorResistance=7.1,MotorInductance=0.1;
    Modelica.Mechanics.Rotational.Interfaces.Flange_b flange_b;
    Modelica.Blocks.Interfaces.RealInput u;
    Modelica.Blocks.Math.Add comparator(k2=-1);
    PID pid(Kp=KP,Kd=KD);
    LowPassFilter filter;
    PWMSaturation pwm;
    Modelica.Electrical.Analog.Basic.Ground ground;
    DCMotor motor(load.J=MotorJ,emf1.k=MotorTorqueK,r1.R=MotorResistance,i1.L=MotorInductance);
    Modelica.Mechanics.Rotational.Sensors.AngleSensor encoder;

  equation 
    connect(u,comparator.u1);
    connect(comparator.y,pid.u);
    connect(pid.y,filter.u);
    connect(filter.y,pwm.u);
    connect(pwm.p,motor.p);
    connect(pwm.n,motor.n);
    connect(motor.n,ground.p);
    connect(motor.flange_b,encoder.flange_a);
    connect(encoder.phi,comparator.u2);
    connect(motor.flange_b,flange_b);
  end ServoWithFilter;
  model SpeedTrapezium
      import SI = Modelica.SIUnits;
    extends Modelica.Blocks.Interfaces.SO;
    parameter Real acc=1,dec=1;
    parameter SI.Length adv=1;
    parameter SI.Velocity vel=1;
    parameter SI.Time startTime=0;
    SI.Time tAcc,tSlew,tDec;

  equation 
    tAcc=vel/acc;
    tDec=vel/dec;
    tSlew=if ((tAcc + tDec)*vel)/2 >= adv then 0 else (adv - ((tAcc + tDec)*vel)/2)/vel;
    y=if time &lt;= startTime then 0 else if time &lt;= startTime + tAcc then (time - startTime)*acc else if time &lt;= startTime + tAcc + tSlew then vel else if time &lt;= startTime + tAcc + tSlew + tDec then vel - (time - startTime - tAcc + tSlew)*dec else 0;
  end SpeedTrapezium;
end Control;

"</Output>
    </InputCell>
   </GroupCell>
   <GroupCell closed="false" >
    <TextCell style="Text" >
     <Text>&lt;html>&lt;head>&lt;meta name="qrichtext" content="1" />&lt;/head>&lt;body style=" white-space: pre-wrap; font-family:MS Shell Dlg; font-size:8.25pt; font-weight:400; font-style:normal; text-decoration:none;">&lt;p style=" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; font-family:Times New Roman; font-size:12pt; color:#000000;">&lt;span style=" font-weight:600;">Motor model&lt;/span>&lt;/p>&lt;/body>&lt;/html></Text>
    </TextCell>
    <TextCell style="Text" >
     <Text>&lt;html>&lt;head>&lt;meta name="qrichtext" content="1" />&lt;/head>&lt;body style=" white-space: pre-wrap; font-family:MS Shell Dlg; font-size:8.25pt; font-weight:400; font-style:normal; text-decoration:none;">&lt;p style=" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; font-family:Times New Roman; font-size:12pt; color:#000000;">This is a DC Motor model.&lt;/p>&lt;/body>&lt;/html></Text>
    </TextCell>
    <InputCell style="Input" closed="false" >
     <Input>list(DCMotor)</Input>
     <Output>"model DCMotor
  Modelica.Electrical.Analog.Interfaces.Pin p,n;
  Modelica.Mechanics.Rotational.Interfaces.Flange_b flange_b;
  Modelica.Electrical.Analog.Basic.Resistor r1(R=10);
  Modelica.Electrical.Analog.Basic.Inductor i1;
  Modelica.Electrical.Analog.Basic.EMF emf1;
  Modelica.Mechanics.Rotational.Inertia load;

equation 
  connect(p,r1.p);
  connect(r1.n,i1.p);
  connect(i1.n,emf1.p);
  connect(emf1.n,n);
  connect(emf1.flange_b,load.flange_a);
  connect(load.flange_b,flange_b);
end DCMotor;

"</Output>
    </InputCell>
   </GroupCell>
   <GroupCell closed="true" >
    <TextCell style="Text" >
     <Text>&lt;html>&lt;head>&lt;meta name="qrichtext" content="1" />&lt;/head>&lt;body style=" white-space: pre-wrap; font-family:MS Shell Dlg; font-size:8.25pt; font-weight:400; font-style:normal; text-decoration:none;">&lt;p style=" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; font-family:Times New Roman; font-size:12pt; color:#000000;">&lt;span style=" font-weight:600;">Example 1 - DC Motor&lt;/span>&lt;/p>&lt;/body>&lt;/html></Text>
    </TextCell>
    <TextCell style="Text" >
     <Text>&lt;html>&lt;head>&lt;meta name="qrichtext" content="1" />&lt;/head>&lt;body style=" white-space: pre-wrap; font-family:MS Shell Dlg; font-size:8.25pt; font-weight:400; font-style:normal; text-decoration:none;">&lt;p style=" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; font-family:Times New Roman; font-size:12pt; color:#000000;">In this example the use of the DC motor is showed. It consists of a constant voltage source connected to the DC motor. A rotational flange connector has been added in order to reuse this model in the following examples.&lt;/p>&lt;/body>&lt;/html></Text>
    </TextCell>
    <InputCell style="Input" closed="false" >
     <Input>model ConstantVoltageMotor
  Modelica.Electrical.Analog.Sources.ConstantVoltage source;
  Modelica.Electrical.Analog.Basic.Ground ground;
  DCMotor dcMotor;
  Modelica.Mechanics.Rotational.Interfaces.Flange_b flange_b;
equation
  connect(ground.p,source.n);
  connect(source.p,dcMotor.p);
  connect(source.n,dcMotor.n);
  connect(dcMotor.flange_b,flange_b);
end ConstantVoltageMotor;</Input>
     <Output>Ok</Output>
    </InputCell>
    <InputCell style="Input" closed="false" >
     <Input>simulate(ConstantVoltageMotor,stopTime=5.0)</Input>
     <Output>record
    resultFile = "ConstantVoltageMotor_res.plt"
end record</Output>
    </InputCell>
    <InputCell style="Input" closed="false" >
     <Input>plot({dcMotor.load.phi})</Input>
     <Output>&lt;html>&lt;head>&lt;meta name="qrichtext" content="1" />&lt;/head>&lt;body style=" white-space: pre-wrap; font-family:MS Shell Dlg; font-size:8.25pt; font-weight:400; font-style:normal; text-decoration:none;">&lt;p style=" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; font-family:Courier New; font-size:11pt; color:#000000;">&lt;span style=" color:#000000;">&lt;img src="file:///C:/OpenModelica1.4.3/bin/OMNoteboook_tempfiles/1.png" width="492" height="250" />&lt;/span>&lt;/p>&lt;/body>&lt;/html></Output>
     <Image name="file:///C:/OpenModelica1.4.3/bin/OMNoteboook_tempfiles/1.png" ></Image>
    </InputCell>
   </GroupCell>
   <GroupCell closed="true" >
    <TextCell style="Text" >
     <Text>&lt;html>&lt;head>&lt;meta name="qrichtext" content="1" />&lt;/head>&lt;body style=" white-space: pre-wrap; font-family:MS Shell Dlg; font-size:8.25pt; font-weight:400; font-style:normal; text-decoration:none;">&lt;p style=" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; font-family:Times New Roman; font-size:12pt; color:#000000;">&lt;span style=" font-weight:600;">Example 2 - Motor &amp;amp; Rollers&lt;/span>&lt;/p>&lt;/body>&lt;/html></Text>
    </TextCell>
    <TextCell style="Text" >
     <Text>&lt;html>&lt;head>&lt;meta name="qrichtext" content="1" />&lt;/head>&lt;body style=" white-space: pre-wrap; font-family:MS Shell Dlg; font-size:8.25pt; font-weight:400; font-style:normal; text-decoration:none;">&lt;p style=" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; font-family:Times New Roman; font-size:12pt; color:#000000;">This example uses the &lt;span style=" font-style:italic;">ConstantVoltageMotor&lt;/span> model of the previous example and attaches the &lt;span style=" font-style:italic;">DriveRoller&lt;/span> to it. It also includes an instance of &lt;span style=" font-style:italic;">PaperRoll&lt;/span> with bigger radius than the drive roller and connects them using a &lt;span style=" font-style:italic;">Cardboard &lt;/span>instance.&lt;/p>&lt;/body>&lt;/html></Text>
    </TextCell>
    <InputCell style="Input" closed="false" >
     <Input>model MotorWithRollers
  ConstantVoltageMotor motor;
  MediaPath.DriveRoller driveRoller;
  MediaPath.PaperRoll paperRoll(r=2);
  MediaPath.Cardboard paper;
equation
  connect(motor.flange_b,driveRoller.flange_a);
  connect(driveRoller.cut_a,paper.cut_b);
  connect(paper.cut_a,paperRoll.cut_b);
end MotorWithRollers;</Input>
     <Output>Ok</Output>
    </InputCell>
    <InputCell style="Input" closed="false" >
     <Input>simulate(MotorWithRollers,stopTime=5.0)</Input>
     <Output>record
    resultFile = "MotorWithRollers_res.plt"
end record</Output>
    </InputCell>
    <InputCell style="Input" closed="false" >
     <Input>plot({driveRoller.phi,paperRoll.phi})</Input>
     <Output>&lt;html>&lt;head>&lt;meta name="qrichtext" content="1" />&lt;/head>&lt;body style=" white-space: pre-wrap; font-family:MS Shell Dlg; font-size:8.25pt; font-weight:400; font-style:normal; text-decoration:none;">&lt;p style=" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; font-family:Courier New; font-size:11pt; color:#000000;">&lt;span style=" color:#000000;">&lt;img src="file:///C:/OpenModelica1.4.3/bin/OMNoteboook_tempfiles/2.png" width="492" height="250" />&lt;/span>&lt;/p>&lt;/body>&lt;/html></Output>
     <Image name="file:///C:/OpenModelica1.4.3/bin/OMNoteboook_tempfiles/2.png" ></Image>
    </InputCell>
   </GroupCell>
   <GroupCell closed="true" >
    <TextCell style="Text" >
     <Text>&lt;html>&lt;head>&lt;meta name="qrichtext" content="1" />&lt;/head>&lt;body style=" white-space: pre-wrap; font-family:MS Shell Dlg; font-size:8.25pt; font-weight:400; font-style:normal; text-decoration:none;">&lt;p style=" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; font-family:Times New Roman; font-size:12pt; color:#000000;">&lt;span style=" font-weight:600;">Example 3 - Controlled system&lt;/span>&lt;/p>&lt;/body>&lt;/html></Text>
    </TextCell>
    <TextCell style="Text" >
     <Text>&lt;html>&lt;head>&lt;meta name="qrichtext" content="1" />&lt;/head>&lt;body style=" white-space: pre-wrap; font-family:MS Shell Dlg; font-size:8.25pt; font-weight:400; font-style:normal; text-decoration:none;">&lt;p style=" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; font-family:Times New Roman; font-size:12pt; color:#000000;">This example is an assembly of a control scheme for two rollers connected by an elastic paper. (Previous to the 'Servo' model implementation, see Example 4)&lt;/p>&lt;/body>&lt;/html></Text>
    </TextCell>
    <InputCell style="Input" closed="false" >
     <Input>model ControlledRoller
  parameter Real driveRollerRadius = 0.03369; //In meters.
  parameter Real paperRollRadius = 2*driveRollerRadius;
  Control.SpeedTrapezium trapezium(adv=0.1016,vel=0.100228);
  Modelica.Blocks.Continuous.Integrator integrator;
  Modelica.Blocks.Math.Add comparator(k2=-1);
  Control.PID controller(Kp=1000,Kd=5000);
  Modelica.Blocks.Math.Gain ang2tangent(k=driveRollerRadius);
  Control.PWMGenerator pwm;
  Modelica.Electrical.Analog.Basic.Ground ground;
  DCMotor motor(load.J=0.0001,emf1.k=0.078,r1.R=7.1,i1.L=0.1);
  Modelica.Mechanics.Rotational.IdealGear gear(ratio=40);
  MediaPath.DriveRoller driveRoller(r=driveRollerRadius,J=0.00365); //Inertia in kg·m^2
  MediaPath.PaperRoll paperRoll(r=paperRollRadius,J=0.008452); //Inertia in kg·m^2
  Modelica.Mechanics.Rotational.Damper friction(d=0.01);
  Modelica.Mechanics.Rotational.Fixed housing;
  Modelica.Blocks.Sources.Constant btTorque(k=-0.9);
  Modelica.Mechanics.Rotational.Torque backtension;
  MediaPath.RealPaper paper(k=1e4);
  Modelica.Mechanics.Rotational.Sensors.AngleSensor encoder;
equation
  connect(trapezium.y,integrator.u);
  connect(integrator.y,comparator.u1);
  connect(comparator.y,controller.u);
  connect(controller.y,pwm.u);
  connect(pwm.n,ground.p);
  connect(pwm.p,motor.p);
  connect(pwm.n,motor.n);
  connect(motor.flange_b,gear.flange_a);
  connect(gear.flange_b,driveRoller.flange_a);
  connect(driveRoller.flange_b,encoder.flange_a);
  connect(encoder.phi,ang2tangent.u);
  connect(ang2tangent.y,comparator.u2);
  connect(driveRoller.cut_a,paper.cut_b);
  connect(paper.cut_a,paperRoll.cut_b);
  connect(btTorque.y,backtension.tau);
  connect(backtension.flange_b,paperRoll.flange_a);
  connect(paperRoll.flange_a,friction.flange_b);
  connect(friction.flange_a,housing.flange_b);
end ControlledRoller;</Input>
     <Output>Ok</Output>
    </InputCell>
    <InputCell style="Input" closed="false" >
     <Input>simulate(ControlledRoller,stopTime=2)</Input>
     <Output>record
    resultFile = "ControlledRoller_res.plt"
end record</Output>
    </InputCell>
    <InputCell style="Input" closed="false" >
     <Input>plot({integrator.u,driveRoller.tanVel})</Input>
     <Output>&lt;html>&lt;head>&lt;meta name="qrichtext" content="1" />&lt;/head>&lt;body style=" white-space: pre-wrap; font-family:MS Shell Dlg; font-size:8.25pt; font-weight:400; font-style:normal; text-decoration:none;">&lt;p style=" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; font-family:Courier New; font-size:11pt; color:#000000;">&lt;span style=" color:#000000;">&lt;img src="file:///C:/OpenModelica1.4.3/bin/OMNoteboook_tempfiles/3.png" width="492" height="250" />&lt;/span>&lt;/p>&lt;/body>&lt;/html></Output>
     <Image name="file:///C:/OpenModelica1.4.3/bin/OMNoteboook_tempfiles/3.png" ></Image>
    </InputCell>
    <InputCell style="Input" closed="false" >
     <Input>plot({integrator.y,driveRoller.tanPos,paperRoll.tanPos})</Input>
     <Output>&lt;html>&lt;head>&lt;meta name="qrichtext" content="1" />&lt;/head>&lt;body style=" white-space: pre-wrap; font-family:MS Shell Dlg; font-size:8.25pt; font-weight:400; font-style:normal; text-decoration:none;">&lt;p style=" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; font-family:Courier New; font-size:11pt; color:#000000;">&lt;span style=" color:#000000;">&lt;img src="file:///C:/OpenModelica1.4.3/bin/OMNoteboook_tempfiles/4.png" width="492" height="250" />&lt;/span>&lt;/p>&lt;/body>&lt;/html></Output>
     <Image name="file:///C:/OpenModelica1.4.3/bin/OMNoteboook_tempfiles/4.png" ></Image>
    </InputCell>
   </GroupCell>
   <GroupCell closed="true" >
    <TextCell style="Text" >
     <Text>&lt;html>&lt;head>&lt;meta name="qrichtext" content="1" />&lt;/head>&lt;body style=" white-space: pre-wrap; font-family:MS Shell Dlg; font-size:8.25pt; font-weight:400; font-style:normal; text-decoration:none;">&lt;p style=" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; font-family:Times New Roman; font-size:12pt; color:#000000;">&lt;span style=" font-weight:600;">Example 4 - Servo driven system&lt;/span>&lt;/p>&lt;/body>&lt;/html></Text>
    </TextCell>
    <InputCell style="Input" closed="false" >
     <Input>model Example4
  parameter Real driveRollerRadius = 0.03369;
  parameter Real gearRatio = 1;
  Control.SpeedTrapezium trapezium(adv=0.1016,vel=0.100228);
  Control.SpeedTrapezium trapezium2(adv=0.1016,vel=0.100228,startTime=4.0);
  Modelica.Blocks.Math.Add sum;
  Modelica.Blocks.Continuous.Integrator integrator;
  Modelica.Blocks.Math.Gain commandCorrector(k=gearRatio/driveRollerRadius);
  Control.DiscreteServoWithGear servo(KP=1,KD=5,filter.T=0.1);
  Modelica.Mechanics.Rotational.IdealGear gear(ratio=gearRatio);
  MediaPath.DriveRoller driveRoller(r=driveRollerRadius,J=0.00365);
  MediaPath.PaperRoll paperRoll(r=0.05,J=0.008452);
  MediaPath.RealPaper paper(k=1e4);
  Modelica.Blocks.Sources.Constant tau(k=-0.9);
  Modelica.Mechanics.Rotational.Torque backtension;
  Modelica.Mechanics.Rotational.Damper friction(d=0.1);
  Modelica.Mechanics.Rotational.Fixed housing;
equation
  connect(trapezium.y,sum.u1);
  connect(trapezium2.y,sum.u2);
  connect(sum.y,integrator.u);
  connect(integrator.y,commandCorrector.u);
  connect(commandCorrector.y,servo.u);
  connect(servo.flange_b,gear.flange_a);
  connect(gear.flange_b,driveRoller.flange_a);
  connect(paperRoll.cut_b,paper.cut_a);
  connect(paper.cut_b,driveRoller.cut_a);
  connect(tau.y,backtension.tau);
  connect(backtension.flange_b,paperRoll.flange_a);
  connect(paperRoll.flange_a,friction.flange_a);
  connect(friction.flange_b,housing.flange_b);
end Example4;</Input>
     <Output>Ok</Output>
    </InputCell>
    <InputCell style="Input" closed="false" >
     <Input>simulate(Example4,stopTime=4)</Input>
     <Output>record
    resultFile = "Example4_res.plt"
end record</Output>
    </InputCell>
    <InputCell style="Input" closed="false" >
     <Input>plot({sum.y,driveRoller.tanVel,paperRoll.tanVel})</Input>
     <Output>&lt;html>&lt;head>&lt;meta name="qrichtext" content="1" />&lt;/head>&lt;body style=" white-space: pre-wrap; font-family:MS Shell Dlg; font-size:8.25pt; font-weight:400; font-style:normal; text-decoration:none;">&lt;p style=" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; font-family:Courier New; font-size:11pt; color:#000000;">&lt;span style=" color:#000000;">&lt;img src="file:///C:/OpenModelica1.4.3/bin/OMNoteboook_tempfiles/5.png" width="492" height="250" />&lt;/span>&lt;/p>&lt;/body>&lt;/html></Output>
     <Image name="file:///C:/OpenModelica1.4.3/bin/OMNoteboook_tempfiles/5.png" ></Image>
    </InputCell>
    <InputCell style="Input" closed="false" >
     <Input>plot({servo.u,servo.flange_b.phi})</Input>
     <Output>&lt;html>&lt;head>&lt;meta name="qrichtext" content="1" />&lt;/head>&lt;body style=" white-space: pre-wrap; font-family:MS Shell Dlg; font-size:8.25pt; font-weight:400; font-style:normal; text-decoration:none;">&lt;p style=" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; font-family:Courier New; font-size:11pt; color:#000000;">&lt;span style=" color:#000000;">&lt;img src="file:///C:/OpenModelica1.4.3/bin/OMNoteboook_tempfiles/6.png" width="492" height="250" />&lt;/span>&lt;/p>&lt;/body>&lt;/html></Output>
     <Image name="file:///C:/OpenModelica1.4.3/bin/OMNoteboook_tempfiles/6.png" ></Image>
    </InputCell>
   </GroupCell>
   <GroupCell closed="false" >
    <TextCell style="Text" >
     <Text>&lt;html>&lt;head>&lt;meta name="qrichtext" content="1" />&lt;/head>&lt;body style=" white-space: pre-wrap; font-family:MS Shell Dlg; font-size:8.25pt; font-weight:400; font-style:normal; text-decoration:none;">&lt;p style=" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; font-family:Times New Roman; font-size:12pt; color:#000000;">&lt;span style=" font-weight:600;">Workspace&lt;/span>&lt;/p>&lt;/body>&lt;/html></Text>
    </TextCell>
    <InputCell style="Input" closed="false" >
     <Input>model Test1
  Control.SpeedTrapezium trapezium(adv=0.1016,vel=0.100228);
  Control.DiscreteServoWithGear servo(KD=1000);
  MediaPath.DriveRoller driveRoller(J=0.00365);
equation
  connect(trapezium.y,servo.u);
  connect(servo.flange_b,driveRoller.flange_a);
end Test1;</Input>
     <Output>Ok</Output>
    </InputCell>
    <InputCell style="Input" closed="false" >
     <Input>simulate(Test1,stopTime=2,numberOfIntervals=20000)</Input>
     <Output>record
    resultFile = "Test1_res.plt"
end record</Output>
    </InputCell>
    <InputCell style="Input" closed="false" >
     <Input>plot({trapezium.y,driveRoller.phi,servo.backlash.flange_a.phi})</Input>
     <Output>&lt;html>&lt;head>&lt;meta name="qrichtext" content="1" />&lt;/head>&lt;body style=" white-space: pre-wrap; font-family:MS Shell Dlg; font-size:8.25pt; font-weight:400; font-style:normal; text-decoration:none;">&lt;p style=" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; font-family:Courier New; font-size:11pt; color:#000000;">&lt;span style=" color:#000000;">&lt;img src="file:///C:/OpenModelica1.4.3/bin/OMNoteboook_tempfiles/7.png" width="492" height="250" />&lt;/span>&lt;/p>&lt;/body>&lt;/html></Output>
     <Image name="file:///C:/OpenModelica1.4.3/bin/OMNoteboook_tempfiles/7.png" ></Image>
    </InputCell>
    <InputCell style="Input" closed="false" >
     <Input>plot({servo.pid.y})</Input>
     <Output>&lt;html>&lt;head>&lt;meta name="qrichtext" content="1" />&lt;/head>&lt;body style=" white-space: pre-wrap; font-family:MS Shell Dlg; font-size:8.25pt; font-weight:400; font-style:normal; text-decoration:none;">&lt;p style=" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; font-family:Courier New; font-size:11pt; color:#000000;">&lt;span style=" color:#000000;">&lt;img src="file:///C:/OpenModelica1.4.3/bin/OMNoteboook_tempfiles/8.png" width="492" height="250" />&lt;/span>&lt;/p>&lt;/body>&lt;/html></Output>
     <Image name="file:///C:/OpenModelica1.4.3/bin/OMNoteboook_tempfiles/8.png" ></Image>
    </InputCell>
   </GroupCell>
  </GroupCell>
 </GroupCell>
</Notebook>
